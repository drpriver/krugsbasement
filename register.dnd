::meta
  property="og:title" content="Register"
  property="og:type" content="website"
  property="og:image" content="https://krugsbasement.com/favicon.ico"
  property="og:url" content="https://krugsbasement.com/register"
  property="og:description" content="Play rpgs with your friends!"
  property="og:site_name" content="Krug's Basement"
::div.login
  ::md.centered
    Have an account? [Login] now!

    Or try out the [Demo].
    ::links
      Demo = /demos/dungeon.html
  Register::title
  ::raw #id(hidden)
    <form action="" method="post">
  ::div.error-item #id(username-errors)
  ::div.login-item .hint
    ::raw
      <span>Between 5 and 32 characters</span>
  ::div.login-item
    ::raw
      <label for="username">Username</label>
      <input id="username" maxlength="32" minlength="5" name="username" required="" size="32" type="text" value="" autocomplete="username">
  ::div.error-item #id(email-errors)
  ::div.login-item
    ::raw
      <label for="email">Email</label>
      <input id="email" name="email" required size="32" type="email" value="" autocomplete="email">
  ::div.error-item #id(password-errors)
  ::div.login-item .hint
    ::raw
      <span>Greater than 7 characters.</span>
  ::div.login-item
    ::raw
      <label for="password">Password</label>
      <input id="password" minlength="8" name="password" required="" size="32" type="password" value="" autocomplete="new-password">
  ::div.error-item #id(password2-errors)
  ::div.login-item
    ::raw
      <label for="password2">Repeat Password</label>
      <input id="password2" name="password2" required="" size="32" type="password" value="">
  ::div.login-item .hint
    ::raw
      <span>Special invitation code.</span>
  ::div.login-item
    ::raw
      <label for="magic">Magic Code</label>
      <input id="magic" name="magic" required="" value="" size="32" autocomplete="off">
  ::div.login-item
    ::raw
      <label for="remember_me">Remember Me</label>
      <input checked="" id="remember_me" name="remember_me" type="checkbox" value="y">
      <input id="register" name="register" type="submit" value="Register">
  ::raw
    </form>
::css #import
  login.css
::script #import
  darkmode.js
