::raw
  <div id="palette" class="window">
    <div id="palette-window-handle" class="window-handle">
    </div>
    <div id="palette-icons">
    </div>
  </div>
::div.chat #id(chat)
  ::div #id(tree)
    ::div
      ::raw
        <select title="Current Map" style="width: 50%; text-overflow:ellipsis;" name="current-map-name" id="current-map-name"></select>
          <button disabled title="Previous Map" style="margin:0;" id="back-map-button">←</button>
          <button disabled title="Next Map" style="margin:0;" id="forward-map-button">→</button>
          <button title="New Map" style="margin:0;" id="new-map-button">+</button>
          <button title="Edit Map" style="margin:0;" id="edit-map-button">✎</button>
    ::div
      ::raw
        <select title="Spreadsheet" style="width: 50%; text-overflow-ellipsis;" name="current-spreadsheet" id="current-spreadsheet"></select>
        <button title="New Tracker" id="new-tracker-button">+</button>
    ::div.three-buttons
      ::raw
        <button id="notes-window-button">Notes…</button>
        <button id="tables-button">Tables…</button>
        <button id="options-button">Options…</button>
    ::div.three-buttons
      ::raw
        <button id="macros-button">Macros…</button>
        <button id="privateroll-button">DMs…</button>
  ::div #id(notifications)
  ::div.log #id(chat-history)
  ::div #id(macro-panel)
    ::div #id(macro-panel-tabs)
    ::div #id(macro-panel-body)
  ::div.log #id(dice-history)
  ::raw
    <textarea spellcheck="false" id="chatinput" rows="4"></textarea>

