      <td>${numbox('value')}
    <tr>
      <td>${label('oneshot', 'One-shot:')}
      <td>${checkbox('oneshot')}
    </table>
  `);
  begin('multiline-text');
  make(`
    ${title("Text")}
    <table class="input-container">
    <tr>
      <td>${textarea('textarea')}
    </table>
  `);
  begin('make-variable');
  make(`
    ${title("Variable")}
    <table class="input-container">
      <tr>
        <td>${label('type', 'Type')}
        <td>${selectbegin('type')}
            <option value="1">Boolean</option>
            <option value="0">Number</option>
            <option value="2">Expression</option>
          </select>
      <tr>
        <td>${label('name', 'Name')}
        <td>${textbox('name')}
    </table>
    `);
  begin('simple-delete');
  make(`
    ${title('Delete')}
    <table class="input-container">
      ${trbegin('can')}
        <td>${label('delete', 'Delete?')}
        <td>${checkbox('delete')}
    </table>`);
  begin('simple-confirm');
  make(`${title('Confirm')}`)
  begin('screenshot-prefs');
  make(`
    ${title('Screenshot')}
    <table class="input-container">
      <tr>
        <td>${label('gridsize', 'Grid Size:')}
        <td>${numbox('gridsize')}
      <tr>
        <td>${label('selection', 'Screenshot Selection')}
        <td>${checkbox('selection')}
      <tr>
        <td>${label('text', 'Draw Text')}
        <td>${checkbox('text')}
      <tr>
        <td>${label('darkmode', 'Darkmode')}
        <td>${checkbox('darkmode')}
    </table>`);
  begin('clipboard');
  make(`
    ${title('Clipboard')}
    <p><b>You or your browser has restricted reading the clipboard so we have
          this crappy dialog instead.</b></p>
    <p>Paste into the textbox then hit ok.</p>
    ${textarea('json')}
  `);
  begin('tracker');
  make(`
    ${title('New Sheet')}
    <table class="input-container">
      <tr>
        <td>${label('name', 'Name')}
        <td>${textbox('name')}
