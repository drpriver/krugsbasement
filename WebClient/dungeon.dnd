      <tr>
        <td>${label('month10', '11th Month')}
        <td>${textbox('month10')}
        <td>${label('month10len', 'Days')}
        <td>${numbox('month10len')}
        <td>${label('day10', '11th Day')}
        <td>${textbox('day10')}
      <tr>
        <td>${label('month11', '12th Month')}
        <td>${textbox('month11')}
        <td>${label('month11len', 'Days')}
        <td>${numbox('month11len')}
        <td>${label('day11', '12th Day')}
        <td>${textbox('day11')}
    </table>
  `);


  if(Args && Args.temp){
    let ts = '// NOTE: this file was generated\n'
    ts += '// Do NOT edit it. Your edits will be overwritten!\n'
    ts += '\n';
    ts += 'interface DialogIdMap {\n';
    for(let prefix of prefixes){
      ts += `  '${prefix}': {\n`;
      for(let pair of items[prefix]){
        ts += `    "${pair[0]}": ${pair[1]};\n`;
      }
      ts += `  };\n`;
    }
    ts += '}\n\n';
    ts += `const DIALOGS: Map<string, any> = new Map();\n`;
    ts += `function get_or_make_dialog<Key extends keyof DialogIdMap>(name:Key):Dialog<Key>{\n`;
    ts += `    if(DIALOGS.has(name)) return DIALOGS.get(name)!;\n\n`;
    ts += `    function register(fields: Array<string>): any{\n`;
    ts += `        let dialog = make_dialog(name, fields);\n`;
    ts += `        DIALOGS.set(name, dialog);\n`;
    ts += `        return dialog;\n`;
    ts += `    }\n\n`;
    ts += `    switch(name){\n`;
    for(let prefix of prefixes){
      ts += `        case '${prefix}':\n`;
      ts += `            return register([`;
      for(let pair of items[prefix])
        ts += `'${pair[0]}', `;
      ts += `]);\n`
    }
    ts += `    }\n`;
    ts += `    throw new Error();\n`;
    ts += '}\n';
    FileSystem.write_file('Generated/dialogdefs.ts', ts);
  }

