      <tr>
        <td>${label('month2', '3rd Month')}
        <td>${textbox('month2')}
        <td>${label('month2len', 'Days')}
        <td>${numbox('month2len')}
        <td>${label('day2', '3rd Day')}
        <td>${textbox('day2')}
      <tr>
        <td>${label('month3', '4th Month')}
        <td>${textbox('month3')}
        <td>${label('month3len', 'Days')}
        <td>${numbox('month3len')}
        <td>${label('day3', '4th Day')}
        <td>${textbox('day3')}
      <tr>
        <td>${label('month4', '5th Month')}
        <td>${textbox('month4')}
        <td>${label('month4len', 'Days')}
        <td>${numbox('month4len')}
        <td>${label('day4', '5th Day')}
        <td>${textbox('day4')}
      <tr>
        <td>${label('month5', '6th Month')}
        <td>${textbox('month5')}
