        <td>${label('numbered', 'Numbered')}
        <td>${checkbox('numbered')}
      <tr>
        <td>${label('function', 'Function')}
        <td>${uncheckbox('function')}
      <tr>
        <td>${label('file', 'Upload TSV')}
        <td>${file('file')}
    </table>

  `);
  begin('sheet-config');
  make(`
    ${title('Sheet Config')}
