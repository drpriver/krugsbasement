::js
  let raw = ctx.make_node(NodeType.RAW);
  node.parent.replace_child(node, raw);
  const windows = [];
  function make_window(prefix, title, content){
    windows.push(prefix);
    const inner = `
      <div id="${prefix}-window" style="display:none" class="window">
      <div id="${prefix}-window-handle" class="window-handle">
        <span class="window-title">${title}</span>
        <span id="${prefix}-close" class="window-closer">×</span>
      </div>
      ${content}
      </div>
    `;
    raw.add_child(inner);
  }
  function make_window2(prefix, title, content){
    windows.push(prefix);
    const inner = `
      <div id="${prefix}-window" style="display:none" class="window2">
      <div id="${prefix}-window-handle" class="window-handle">
        <span class="window-title">${title}</span>
        <span id="${prefix}-close" class="window-closer">×</span>
      </div>
      ${content}
      </div>
    `;
    raw.add_child(inner);
  }
  make_window('notes', 'Notes', `
    <div id="notes-container" class="window-container">
      <div id="notes-list" class="window-group-list">
        <button id="new-note">
          + New Note
        </button>
      </div>
      <div id="notes-window-iframe-container">
        <div id="notes-buttons">
          <button id="edit-notes-button">Edit</button>
          <button id="delete-note">Delete</button>
        </div>
        <iframe id="current-note-view"></iframe>
      </div>
      <div id="note-view-editor-container" style="display:none">
        <textarea spellcheck="false" id="note-view-title" rows=1></textarea>
        <textarea spellcheck="false" id="note-view-edit"></textarea>
        <div id="note-view-editor-log"></div>
      </div>
    </div>
  `);
  make_window2('macros', 'Macros', `
    <div id="macros-container">
      <div id="macros-group-list" class="window-group-list">
        <button id="new-macro-group">+ New Group</button>
      </div>
      <div id="macros-list" class="window-group-list">
        <button id="new-macro">+ New Macro</button>
      </div>
      <div id="macro-var-list" class="window-group-list">
        <button id="new-variable">+ New Variable</button>
      </div>
      <div id="macro-editor" style="visibility:hidden;">
        <div id="macros-buttons">
          <button id="test-macro">Test</button>
          <button id="use-macro">Use</button>
          <a target="_blank" href="/docs/macro-doc.html">Help</a>
          <a target="_blank" href="macros" id="mac-link">Macro Page</a>
        </div>
        <div style="text-align:center;">
            <h2 id="macro-view-title"></h2>
        </div>
        <div id="asdf-variable">
          <textarea spellcheck="false" id="macro-view-edit"></textarea>
          <div id="local-vars" class="window-group-list">
            <button id="new-local-var">+ New Macro Var</button>
          </div>
        </div>
        <div id="macro-test-log"></div>
      </div>
    </div>
  `);
  make_window('rolltable', 'Roll Tables',
  `
    <div id="rolltable-container" class="window-container">
      <div class="window-tab">
        <span id="rolltable-shared" class="active-tab">Shared Tables</span>
        <span id="rolltable-private">My Tables</span>
        <button id="rolltable-paste">Paste rows from clipboard</button>
      </div>
      <div id="rolltable-group-list" class="window-group-list">
        <button id="rolltable-add-table">+ New Table</button>
      </div>
        <div id="rolltable-table-container">
          <table>
            <thead>
              <tr>
                <th></th>
                <th>Weight</th>
                <th>Value</th>
                <th>Table?</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="rolltable-body">
            </tbody>
          </table>
        </div>
    </div>
  `);
  make_window('privateroll', 'Private Rolls',
  `
    <div id="privateroll-container" class="window-container">
      <div id="privateroll-targets" class="window-group-list"> </div>
      <div class="log" id="privateroll-history">
      </div>
      <textarea spellcheck="false" id="privateroll-input" rows="4"></textarea>
      <div id="privateroll-tables">
        <div id="privateroll-tables-tabs">
          <div id="privateroll-tables-tab">Tables</div>
          <div id="privateroll-mytables-tab">MyTables</div>
        </div>
        <div id="privateroll-tables-shared">
        </div>
        <div id="privateroll-tables-private">
        </div>
      </div>
    </div>
  `);
  if(Args && Args.temp){
    let ts = '// NOTE: this file was generated\n'
    ts += '// Do NOT edit it. Your edits will be overwritten!\n'
    ts += '\n';
    ts += 'interface SubWindowIdMap {\n';
    for(let prefix of windows){
      ts += `  '${prefix}': SubWindow;\n`;
    }
    ts += '}\n\n';
    FileSystem.write_file('Generated/subwindowdefs.ts', ts);
  }
  //endjs
::js
  let raw = ctx.make_node(NodeType.RAW);
  node.parent.replace_child(node, raw);
  let current_prefix = '';
  let items = {};
  let prefixes = [];
  function begin(prefix){
    current_prefix = prefix;
    items[prefix] = [];
    prefixes.push(prefix);
  }
  function make(content){
    let prefix = current_prefix;
    content = content.replaceAll('id="', 'id="'+prefix+'-');
    content = content.replaceAll('for="', 'for="'+prefix+'-');
    content = content.replaceAll('name="', 'name="'+prefix+'-');
    const html =
    `<div id="${prefix}" style="display:none;" class="hover">
    <div id="${prefix}-window-handle" class="window-handle">
    <span id="${prefix}-window-close" class="window-closer">X</span>
    </div>
    ${content}
    <div class="hover-button-container">
      <button type="button" id="${prefix}-ok">Ok</button>
      <button type="button" id="${prefix}-cancel">Cancel</button>
    </div>
    </div>`;
    raw.add_child(html);
  }
  function label(name, text){
    return `<label for="${name}">${text}</label>`;
  }
  function numbox(name){
    items[current_prefix].push([name, 'HTMLInputElement']);
    return `<input type="number" name="${name}" id="${name}" class="numeric-input">`;
  }
  function checkbox(name){
    items[current_prefix].push([name, 'HTMLInputElement']);
    return `<input type="checkbox" name="${name}" id="${name}" checked>`;
  }
  function uncheckbox(name){
    items[current_prefix].push([name, 'HTMLInputElement']);
    return `<input type="checkbox" name="${name}" id="${name}">`;
  }
  function urlbox(name){
    items[current_prefix].push([name, 'HTMLInputElement']);
    return `<input type="url" name="${name}" id="${name}" value="">`;
  }
  function textbox(name){
    items[current_prefix].push([name, 'HTMLInputElement']);
    return `<input type="text" name="${name}" id="${name}" value="" spellcheck="false">`;
  }
  function title(text){
    items[current_prefix].push(['title', 'HTMLHeadingElement']);
    return `<h2 id="title">${text}</h2>`;
  }
  function textarea(name){
    items[current_prefix].push([name, 'HTMLTextAreaElement']);
    return `<textarea name="${name}" id="${name}"></textarea>`
  }
  function radio(name){
    items[current_prefix].push([name, 'HTMLInputElement']);
    return `<input type="radio" id="${name}" name="${name}" value="auto">`;
  }
  function colorbox(name){
    items[current_prefix].push([name, 'HTMLInputElement']);
    return `<input type="color" id="${name}" name="${name}">`;
  }
  // for when you just need a placeholder div.
  function div(name){
    items[current_prefix].push([name, 'HTMLDivElement']);
    return `<div id="${name}"></div>`
  }
  function selectbegin(name){
    items[current_prefix].push([name, 'HTMLSelectElement']);
    return `<select id="${name}">`;
  }
  function trbegin(name){
    items[current_prefix].push([name, 'HTMLTableRowElement']);
    return `<tr id="${name}">`;
  }
  function tablebegin(name){
    items[current_prefix].push([name, 'HTMLTableElement']);
    return `<table id="${name}">`;
  }
  function button(name, text){
    items[current_prefix].push([name, 'HTMLButtonElement']);
    return `<button id="${name}">${text}</button>`;
  }
  // We have this stupid begin thing as the function calls
  // inside the template strings will be evaluated eagerly,
  // so it is too late to set the current prefix before we
  // get to them.
  begin('image-input');
  make(`
    ${title("Enter Image")}
    <table class="input-container">
      <tr>
        <td>${label("width", "Width:")}${numbox("width")}
        <td>${label("height", "Height:")}${numbox("height")}
      <tr>
        <td>${label("checkbox", "Round to Grid:")}${checkbox("checkbox")}
        <td>${label("background", "Background")}${checkbox("background")}
      <tr>
        <td colspan="2">${label("url", "URL:")}${urlbox("url")}
    </table>
  `);

  begin('text-input');
  make(`
    ${title("Enter Text")}
    <table class="input-container">
      <tr>
        <td>${label("size", "Size:")}
        <td>${numbox("size")}
        <tr>
          <td>Alignment:
          <td>
              ${radio("left")}${label("left", "Left")}
              ${radio("center")}${label("center", "Center")}
              ${radio("right")}${label("right", "Right")}
          </td>
        <tr>
          <td>${label("text", "Text:")}
          <td>${textarea("text")}
        <tr>
          <td>Link To Map:
          <td>
            ${selectbegin('link-dungeon')}
              <option value="-1">No Link</option>
            </select>
        <tr>
          <td>Link To SubMap:
          <td>
            ${selectbegin('link-submap')}
              <option value="-1">No Link</option>
            </select>
        <tr>
          <td>${label('background', "Background:")}
          <td>${checkbox('background')}
    </table>
  `);
  begin('map-input');
  make(`
    ${title('New Map')}
    <table class='input-container'>
      <tr>
        <td>${label('name', 'Map Name:')}
        <td colspan=4>${textbox('name')}
      <tr>
        <td>${label('hex-grid', 'Hex Grid')}
        <td>${checkbox('hex-grid')}
        <td>${label('grid-color', 'Grid Color')}
        <td>${colorbox('grid-color')}
        <td>${textbox('grid-color-text')}
      <tr>
        <td>${label('no-grid', 'No Grid')}
        <td>${checkbox('no-grid')}
        <td>${label('bg-color', 'Bg Color')}
        <td>${colorbox('bg-color')}
        <td>${textbox('bg-color-text')}
      <tr>
        <td>${label('numbered', 'Numbered')}
        <td>${checkbox('numbered')}
      <tr>
        <td>${label('big', 'BigHex')}
        <td>${checkbox('big')}
      <tr>
        <td>${label('delete', 'Delete Map')}
        <td>${checkbox('delete')}
    </table>`);
  begin('map-delete');
  make(`
    ${title('Delete Map')}
    <table class="input-container">
      ${trbegin('can')}
        <td>${label('delete', 'DeleteMap')}
        <td>${checkbox('delete')}
      ${trbegin('cant')}
        <td colspan=2>This map can't be deleted.
    </table>`);
  begin('ez-token');
  make(`
    ${title('New Token')}
    <table class="input-container">
      <tr>
        <td>${label('color', 'Color:')}
        <td>${colorbox('color')}
        <td>
        <td>
      <tr>
        <td>${label('width', 'Width (sq):')}
        <td>${numbox('width')}
        <td>${label('height', 'Height (sq):')}
        <td>${numbox('height')}
      <tr>
        <td>${label('text', 'Text:')}
        <td colspan="3">${textbox('text')}
    </table>
    ${div('conditions')}
    `);
  begin('img-token');
  make(`
    ${title('New Token')}
    ${div('gallery')}
    <table class="input-container">
      <tr>
        <td>${label('width', 'Width (sq):')}
        <td>${numbox('width')}
        <td>${label('height', 'Height (sq):')}
        <td>${numbox('height')}
      <tr>
        <td>${label('url', 'Token Image Url:')}
        <td colspan=3>${urlbox('url')}
    </table>
    ${div('conditions')}
    `);
  begin('submap');
  make(`
    ${title('Edit Submap')}
    <table class="input-container">
      <tr>
        <td>${label('sm-title', 'Title:')}
        <td colspan=2>${textbox('sm-title')}
      <tr>
        <td>${label('grid-color', 'Grid Color')}
        <td>${colorbox('grid-color')}
        <td>${textbox('grid-color-text')}
      <tr>
        <td>${label('bg-color', 'Bg Color')}
        <td>${colorbox('bg-color')}
        <td>${textbox('bg-color-text')}
    </table>`);
  begin('macro-deletion');
  make(`
    ${title('Delete Macro')}
    <table class="input-container">
      <tr>
        <td>${label('checkbox', 'Delete Macro:')}
        <td>${checkbox('checkbox')}
    </table>`);
  begin('note-deletion');
  make(`
    ${title('Delete Note')}
    <table class="input-container">
      <tr>
        <td>${label('checkbox', 'Delete Note:')}
        <td>${checkbox('checkbox')}
    </table>`);
  begin('options');
  make(`
    ${title('Options')}
    <table class="input-container">
      <tr>
        <td>${label('chatname', 'Chat Name:')}
        <td>${textbox('chatname')}
      </tr>
    </table>
    <div class="hover-button-container">
      ${label('hidepan', 'Hide Pan Tool')}
      ${uncheckbox('hidepan')}
      <br>
      ${label('showzoom', 'Show Zoom Buttons')}
      ${checkbox('showzoom')}
      <br>
      ${label('hidechat', 'Hide Chat')}
      ${uncheckbox('hidechat')}
      <br>
      <span style="font-weight:bold">Dark Mode:</span>
      ${radio('system')}
      ${label('system', 'System')}
      ${radio('dark')}
      ${label('dark', 'Dark')}
      ${radio('light')}
      ${label('light', 'Light')}
      <br>
      <span>(might need reload)</span>
      <br>
      ${button('fullscreen', 'Toggle Full Screen')}
      <span>
        <br>
        ${button('export-map', 'Export Maps')}
        ${button('import-map', 'Import Map')}
        <br>
        ${button('screenshot', 'Screenshot')}
      </span>
      <br>
    </div>
    ${tablebegin('dev')}
      <tr>
        <td>${checkbox('fps')} ${label('fps', 'Show FPS')}
    </table>
    <a style="margin:auto; -webkit-appearance: button;" href="/logout">Log Out</a>
    `);
  begin('simple-text');
  make(`
    ${title("Text")}
    <table class="input-container">
      <tr>
        <td>${label('text', 'Text:')}
        <td>${textbox('text')}
    </table>
    `);
  begin('make-variable');
  make(`
    ${title("Variable")}
    <table class="input-container">
      <tr>
        <td>${label('type', 'Type')}
        <td>${selectbegin('type')}
            <option value="0">Number</option>
            <option value="1">Boolean</option>
            <option value="2">Expression</option>
            <option value="3">3.5 Ability Score</option>
          </select>
      <tr>
        <td>${label('name', 'Name')}
        <td>${textbox('name')}
    </table>
    `);
  begin('simple-delete');
  make(`
    ${title('Delete')}
    <table class="input-container">
      ${trbegin('can')}
        <td>${label('delete', 'Delete?')}
        <td>${checkbox('delete')}
    </table>`);
  begin('screenshot-prefs');
  make(`
    ${title('Screenshot')}
    <table class="input-container">
      <tr>
        <td>${label('gridsize', 'Grid Size:')}
        <td>${numbox('gridsize')}
      <tr>
        <td>${label('selection', 'Screenshot Selection')}
        <td>${checkbox('selection')}
      <tr>
        <td>${label('submaps', 'Include Submaps')}
        <td>${checkbox('submaps')}
      <tr>
        <td>${label('text', 'Draw Text')}
        <td>${checkbox('text')}
      <tr>
        <td>${label('darkmode', 'Darkmode')}
        <td>${checkbox('darkmode')}
    </table>`);
  begin('clipboard');
  make(`
    ${title('Clipboard')}
    <p><b>You or your browser has restricted reading the clipboard so we have
          this crappy dialog instead.</b></p>
    <p>Paste into the textbox then hit ok.</p>
    ${textarea('json')}
  `);
  begin('tracker');
  make(`
    ${title('New Sheet')}
    <table class="input-container">
      <tr>
        <td>${label('name', 'Name:')}
        <td>${textbox('name')}
      <tr>
        <td>${label('numbered', 'Numbered')}
        <td>${checkbox('numbered')}
    </table>

  `);
  begin('sheet-config');
  make(`
    ${title('Sheet Config')}
    <table class="input-container">
      <tr>
        <td>${label('editcells', 'Can Edit Cells')}
        <td>${checkbox('editcells')}
      <tr>
        <td>${label('addrows', 'Can Add Rows')}
        <td>${checkbox('addrows')}
      <tr>
        <td>${label('addcols', 'Can Add Columns')}
        <td>${checkbox('addcols')}
      <tr>
        <td>${label('moverows', 'Can Move Rows')}
        <td>${checkbox('moverows')}
      <tr>
        <td>${label('movecols', 'Can Move Columns')}
        <td>${checkbox('movecols')}
      <tr>
        <td>${label('delrows', 'Can Delete Rows')}
        <td>${checkbox('delrows')}
      <tr>
        <td>${label('delcols', 'Can Delete Columns')}
        <td>${checkbox('delcols')}
      <tr>
        <td>${label('sort', 'Can Sort Columns')}
        <td>${checkbox('sort')}
    </table>
    `);


  if(Args && Args.temp){
    let ts = '// NOTE: this file was generated\n'
    ts += '// Do NOT edit it. Your edits will be overwritten!\n'
    ts += '\n';
    ts += 'interface DialogIdMap {\n';
    for(let prefix of prefixes){
      ts += `  '${prefix}': {\n`;
      for(let pair of items[prefix]){
        ts += `    "${pair[0]}": ${pair[1]};\n`;
      }
      ts += `  };\n`;
    }
    ts += '}\n\n';
    ts += `const DIALOGS: Map<string, any> = new Map();\n`;
    ts += `function get_or_make_dialog<Key extends keyof DialogIdMap>(name:Key):Dialog<Key>{\n`;
    ts += `    if(DIALOGS.has(name)) return DIALOGS.get(name)!;\n\n`;
    ts += `    function register(fields: Array<string>): any{\n`;
    ts += `        let dialog = make_dialog(name, fields);\n`;
    ts += `        DIALOGS.set(name, dialog);\n`;
    ts += `        return dialog;\n`;
    ts += `    }\n\n`;
    ts += `    switch(name){\n`;
    for(let prefix of prefixes){
      ts += `        case '${prefix}':\n`;
      ts += `            return register([`;
      for(let pair of items[prefix])
        ts += `'${pair[0]}', `;
      ts += `]);\n`
    }
    ts += `    }\n`;
    ts += `    throw new Error();\n`;
    ts += '}\n';
    FileSystem.write_file('Generated/dialogdefs.ts', ts);
  }

