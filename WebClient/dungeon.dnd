    `);
  begin('cal-dialog');
  make(`
    ${title('Calendar')}
    <table class="input-container">
      <tr>
        <td>${label('start-year', 'First Year')}
        <td>${numbox('start-year')}
        <td>${label('gregorian', 'Gregorian')}
        <td>${checkbox('gregorian')}
        <td>${label('start-day', "New Year's Day")}
        <td>${textbox('start-day')}
      <tr>
        <td>${label('month0', '1st Month')}
        <td>${textbox('month0')}
