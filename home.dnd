::md.right
  [Logout]
  ::links
    logout = /logout
::md.center
  Home::title
  ::md
    ::js
      node.parent.parse(`Welcome ${Args.name}, this is your home`);

  There's not much here yet, but it is something.
  Campaigns::md
    ::js
      if(Args.campaigns.length){
        let s = 'Go to a Campaign:\n';
        let i = 0;
        for(let [id, campaign] of Args.campaigns){
          if(!campaign) continue;
          s += `* [${campaign} | ${i}]\n`;
          ctx.add_link(''+i, `/campaigns/${id}`);
          i++;
        }
        node.parent.parse(s);
      }
      else {
        node.parent.add_child('You have not joined any campaigns yet');
      }
  Your Campaigns::md
    ::js
      if(Args.ownedcampaigns.length){
        let raw = node.parent.make_child(NodeType.RAW);
        raw.add_child('<table><tbody>')
        for(let [id, campaign, magic] of Args.ownedcampaigns){
          if(magic)
            raw.add_child(`<tr>
              <td><a href="/campaigns/${id}">${campaign}</a></td>
              <td><button onclick="getmagic('${id}', '${magic}')">Copy Magic Link to Clipboard</button></td>
              <td><button onclick="revokemagic('${id}', '${magic}')">Revoke Magic Link</button></td>
              </tr>`);
          else
            raw.add_child(`<tr>
            <td><a href="/campaigns/${id}">${campaign}</a></td>
            <td><button onclick="createmagic('${id}')">Create Magic Link</button></td>
            </tr>`);
        }
        raw.add_child('</table>')
      }
      else {
        node.parent.hide = true;
      }
    ::script
      function getmagic(id, magic){
        navigator.clipboard.writeText(`${location.host}/campaigns/${id}?magic=${magic}`);
      }
      function revokemagic(id, magic){
        fetch('/campaigns', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({action:'revokemagic', campaign:id, magic:magic}),
        })
        .then(location.reload());
      }
      function createmagic(id){
        fetch('/campaigns', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({action:'createmagic', campaign:id}),
        })
        .then(location.reload());
      }
  Create a Campaign::md
    ::js
      let raw = node.parent.make_child(NodeType.RAW);
      raw.add_child(`<form action="" method="post">`);
      raw.add_child(Args.form.hidden);
      raw.add_child(`<label for="campaignname">Name:</label>`);
      raw.add_child(`<input id="campaignname" name="campaignname" size="32" required type="text" maxlength="64" minlength="5">`);
      raw.add_child(`<input id="submit" name="submit" type="submit" value="Create">`);
      raw.add_child(`</form>`);

  Settings::md
    ::raw
      <b>Dark Mode</b>:<br>
      <input id="darkmode-sys" name="darkmode" type="radio" value="auto">
      <label for="darkmode-sys">System</label>
      <br>
      <input id="darkmode-dark" name="darkmode" type="radio" value="auto">
      <label for="darkmode-dark">Dark</label>
      <br>
      <input id="darkmode-light" name="darkmode" type="radio" value="auto">
      <label for="darkmode-light">Light</label>
      <br>
::css #import
  login.css
::script #import
  darkmode.js
::script
  document.addEventListener('DOMContentLoaded', function(){
    const dark_sys = document.getElementById('darkmode-sys');
    const dark_dark = document.getElementById('darkmode-dark');
    const dark_light = document.getElementById('darkmode-light');
    fetch('/settings')
    .then(response => response.json())
    .then(settings => {
        let mode = settings.darkmode | 0;
        if(mode < 0 || mode > 2) mode = 0;
        set_darkmode(mode);
      switch(current_dark_mode){
        case 0:
          dark_sys.checked = true;
          break;
        case 1:
          dark_dark.checked = true;
          break;
        case 2:
          dark_light.checked = true;
          break;
      }
      localStorage.setItem('settings.darkmode', ''+mode);
      function post_mode(mode){
        set_darkmode(mode);
        localStorage.setItem('settings.darkmode', ''+mode);
        fetch('/settings', {
            method: 'POST',
            headers: {
                "Content-Type": "application/json",
            },
            body: JSON.stringify({darkmode:mode})
        });
      }
      dark_sys.addEventListener('change', function(){ post_mode(0); });
      dark_dark.addEventListener('change', function(){ post_mode(1); });
      dark_light.addEventListener('change', function(){ post_mode(2); });
    });
  });
