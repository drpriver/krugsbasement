::comment
  Copyright © 2021-2023, David Priver

::meta
  property="og:title" content="Register"
  property="og:type" content="website"
  property="og:image" content="https://krugsbasement.com/favicon.ico"
  property="og:url" content="https://krugsbasement.com/login"
  property="og:description" content="Play rpgs with your friends!"
  property="og:site_name" content="Krug's Basement"
  name="apple-mobile-web-app-capable" content="yes"
::div.login
  ::md.centered
    No account? [Register] now!

    Or try out the [Demo].
    ::links
      Demo = /demos/dungeon.html
  Log In::title
  ::raw #id(hidden)
    <form action="" method="post">
  ::div.error-item #id(username-errors)
  ::div.login-item
    ::raw
      <label for="username">Username</label>
      <input id="username" name="username" required="" size="32" type="text" value="" autocomplete="username">
  ::div.error-item #id(password-errors)
  ::div.login-item
    ::raw
      <label for="password">Password</label>
      <input id="password" name="password" required="" size="32" type="password" value="" autocomplete="current-password">
  ::div.login-item
    ::raw
      <label for="remember_me">Remember Me</label>
      <input checked="" id="remember_me" name="remember_me" type="checkbox" value="y">
      <input id="login" name="login" type="submit" value="Sign In">
  ::raw
    </form>
::css #import
  login.css
::script #import
  darkmode.js
