::meta
  property="og:title" content="Register"
  property="og:type" content="website"
  property="og:image" content="https://krugsbasement.com/favicon.ico"
  property="og:url" content="https://krugsbasement.com/login"
  property="og:description" content="Play rpgs with your friends!"
  property="og:site_name" content="Krug's Basement"
::div.login
  ::md.centered
    No account? [Register] now!
    ::js
      ctx.add_link('register', Args.next_page?`/register?${Args.next_page}`:'/register');
  Log In::title
  ::raw
    <form action="" method="post">
  ::js
    node.parent.children[2].add_child(Args.hidden);
  ::div.error-item
    ::js
      if(Args.messages.length){
        let raw = node.parent.make_child(NodeType.RAW);
        raw.add_child('<ul class="error">');
        for(let mess of Args.messages)
          raw.add_child(`<li class="error">${mess}</li>`);
        raw.add_child('</ul>');
      }
      if(Args.username.errors.length){
        let raw = node.parent.make_child(NodeType.RAW);
        raw.add_child('<ul class="error">');
        for(let err of Args.username.errors)
          raw.add_child(`<li class="error">${err}</li>`);
        raw.add_child('</ul>');
      }
  ::div.login-item
    ::raw
      <label for="username">Username</label>
      <input id="username" name="username" required="" size="32" type="text" value="" autocomplete="username">
  ::div.error-item
    ::js
      if(Args.password.errors.length){
        let raw = node.parent.make_child(NodeType.RAW);
        raw.add_child('<ul class="error">');
        for(let err of Args.password.errors)
          raw.add_child(`<li class="error">${err}</li>`);
        raw.add_child('</ul>');
      }
  ::div.login-item
    ::raw
      <label for="password">Password</label>
      <input id="password" name="password" required="" size="32" type="password" value="" autocomplete="current-password">
  ::div.login-item
    ::raw
      <label for="remember_me">Remember Me</label>
      <input checked="" id="remember_me" name="remember_me" type="checkbox" value="y">
      <input id="login" name="login" type="submit" value="Sign In">
  ::raw
    </form>
::css #import
  login.css
::script #import
  darkmode.js
