enum DarkMode: int
    SYSTEM = 0
    DARK = 1
    LIGHT = 2

# TODO: spreadsheet mode?
enum UiMode: int
    NORMAL = 1
    CHAT = 2

enum SpreadSheetFlags: int flag
    NONE                   = 0
    CAN_ADD_ROW            = 1 << 0
    CAN_ADD_COL            = 1 << 1
    CAN_SORT_COLS          = 1 << 2
    ADD_ROW_ON_ENTER       = 1 << 3
    CAN_DEL_ROW            = 1 << 4
    CAN_DEL_COL            = 1 << 5
    NUMBERED               = 1 << 6
    CAN_MOVE_COLUMNS       = 1 << 7
    CAN_MOVE_ROWS          = 1 << 8
    LOCKED_FORMULAS        = 1 << 9
    CAN_EDIT_CELLS         = 1 << 10
    IS_FUNCTION            = 1 << 11 // don't include in ALL
    ALL                    = NONE | CAN_ADD_ROW | CAN_ADD_COL | CAN_SORT_COLS | ADD_ROW_ON_ENTER | CAN_DEL_ROW | CAN_DEL_COL | NUMBERED | CAN_MOVE_COLUMNS | CAN_MOVE_ROWS | CAN_EDIT_CELLS

enum CellFlags: int flag
    NONE      = 0
    BOLD      = 1 << 0
    ITALIC    = 1 << 1
    UNDERLINE = 1 << 2
    STRIKETHROUGH = 1 << 3

struct CellData: array
    text: str
    name: str
    flags: CellFlags

struct SpreadSheetData: dict
    id: int
    name: str
    flags: SpreadSheetFlags
    column_names: [str]
    cells: [CellData]
    parent: int
    n_args: int
    outx: int
    outy: int

enum SpreadSheetMsgType: int
    DELETE_ROW = 0
    DELETE_COL = 1
    RENAME_COL = 2
    EDIT_CELL = 3
    ADD_ROW = 4
    ADD_COL = 5
    NEW_SHEET = 6
    SORT = 7
    INITIALIZE = 8
    MOVE_COL = 9
    MOVE_ROW = 10
    SHOW = 11
    FLAG = 12
    NAME = 13
    DELETE = 14
    PARENT = 15
    FUNCTION_IO = 16
    EDIT_CELLS = 17

struct SpreadSheetDeleteRow: array
    type = SpreadSheetMsgType.DELETE_ROW
    sheet_id: int
    row_idx: int

struct SpreadSheetDeleteCol: array
    type = SpreadSheetMsgType.DELETE_COL
    sheet_id: int
    col_idx: int

struct SpreadSheetRenameCol: array
    type = SpreadSheetMsgType.RENAME_COL
    sheet_id: int
    col_idx: int
    name: str

struct SpreadSheetMoveCol: array
    type = SpreadSheetMsgType.MOVE_COL
    sheet_id: int
    from_col_idx: int
    to_col_idx: int

struct SpreadSheetMoveRow: array
    type = SpreadSheetMsgType.MOVE_ROW
    sheet_id: int
    from_row_idx: int
    to_row_idx: int

struct SpreadSheetEditCell: array
    type = SpreadSheetMsgType.EDIT_CELL
    sheet_id: int
    row_idx: int
    col_idx: int
    value: CellData

struct SpreadSheetEditCells: array
    type = SpreadSheetMsgType.EDIT_CELLS
    sheet_id: int
    row_idx: [int]
    col_idx: [int]
    value: [CellData]

struct SpreadSheetAddRow: array
    type = SpreadSheetMsgType.ADD_ROW
    sheet_id: int
    whence: int

struct SpreadSheetAddCol: array
    type = SpreadSheetMsgType.ADD_COL
    sheet_id: int
    whence: int

struct SpreadSheetSort: array
    type = SpreadSheetMsgType.SORT
    sheet_id: int
    idxes: [int]

struct SpreadSheetNewSheet: array
    type = SpreadSheetMsgType.NEW_SHEET
    data: SpreadSheetData

struct SpreadSheetInitialize: array
    type = SpreadSheetMsgType.INITIALIZE
    data: [SpreadSheetData]

struct SpreadSheetShow: array
    type = SpreadSheetMsgType.SHOW
    sheet_id = int

struct SpreadSheetFlag: array
    type = SpreadSheetMsgType.FLAG
    sheet_id = int
    flags: int

struct SpreadSheetName: array
    type = SpreadSheetMsgType.NAME
    sheet_id = int
    name: str

struct SpreadSheetDelete: array
    type = SpreadSheetMsgType.DELETE
    sheet_id = int

struct SpreadSheetParent: array
    type = SpreadSheetMsgType.PARENT
    sheet_id = int
    parent: int

struct SpreadSheetFunctionIO: array
    type = SpreadSheetMsgType.FUNCTION_IO
    sheet_id: int
    # Args start in first row, first column
    # and go left to right.
    n_args: int
    outx: int
    outy: int

union SpreadSheetMsg: array
    SpreadSheetDeleteRow
    SpreadSheetDeleteCol
    SpreadSheetRenameCol
    SpreadSheetMoveCol
    SpreadSheetMoveRow
    SpreadSheetEditCell
    SpreadSheetAddRow
    SpreadSheetAddCol
    SpreadSheetNewSheet
    SpreadSheetSort
    SpreadSheetInitialize
    SpreadSheetShow
    SpreadSheetFlag
    SpreadSheetName
    SpreadSheetDelete
    SpreadSheetParent
    SpreadSheetFunctionIO
    SpreadSheetEditCells

enum MetadataType: int
    HOMEPAGE = 0

struct MetadataHomePageMsg: array
    type = MetadataType.HOMEPAGE
    url: str

union MetadataMsg: array
    MetadataHomePageMsg

enum CalendarMsgType: int
    INITIALIZE = 0
    EDITDAY = 1
    ADDYEAR = 2
    SHOW = 3

struct CalendarDay: array
    year: int
    month: int # 0-based
    day: int # 0-based
    txt: str

enum CalendarFlags: int flag
    NONE = 0
    GREGORIAN = 1 << 0

struct CalendarInitialize: array
    type = CalendarMsgType.INITIALIZE
    starting_year: int
    starting_day_of_week: int # 0-based
    month_names: [str]
    month_lengths: [int]
    weekday_names: [str]
    flags: CalendarFlags
    data: [CalendarDay]

struct CalendarEditDay: array
    type = CalendarMsgType.EDITDAY
    data: [CalendarDay]

struct CalendarAddYear: array
    type = CalendarMsgType.ADDYEAR

struct CalendarShow: array
    type = CalendarMsgType.SHOW
    year: int
    month: int

union CalendarMsg: array
    CalendarInitialize
    CalendarEditDay
    CalendarAddYear
    CalendarShow

enum ClockMsgType: int
    INITIALIZE = 0
    SHOW = 1
    NEW = 2
    EDIT = 3
    DELETE = 4
    CLEAR = 5
    # Clock Events
    EVENT_NEW = 6
    EVENT_EDIT = 7
    EVENT_DELETE = 8

struct ClockInitialize: dict
    type = ClockMsgType.INITIALIZE
    clocks: [ClockData]

enum ClockFlags: int flag
    NONE = 0
    # Clock counts down instead of up
    DESCENDING = 1 << 0
    # Jump to next event when advancing the clock
    ADVANCES_BY_EVENT = 1 << 1
    # Wraps to first/last event
    # Currently only works with ADVANCES_BY_EVENT
    CYCLIC = 1 << 2

struct ClockData: dict
    id: int
    name: str
    value_name: str
    value: int
    flags: ClockFlags
    events: [ClockEvent]
    hidinguser: int # userid

enum ClockEventFlags: int flag
    NONE = 0
    # Delete the event after advancing past it
    ONE_SHOT = 1 << 0

struct ClockEvent: dict
    name: str
    when: int
    flags: ClockEventFlags
    id: int

struct ClockShow: dict
    type = ClockMsgType.SHOW
    id: int

struct ClockNew: dict
    type = ClockMsgType.NEW
    name: str
    flags: ClockFlags
    id: int
    value: int
    value_name: str
    hidinguser: int # userid

struct ClockEdit: dict
    type = ClockMsgType.EDIT
    id: int
    name: str
    value_name: str
    value: int
    flags: ClockFlags
    hidinguser: int # userid

struct ClockDelete: dict
    type = ClockMsgType.DELETE
    id: int

struct ClockEventNew: dict
    type = ClockMsgType.EVENT_NEW
    clock_id: int
    name: str
    when: int
    flags: ClockEventFlags
    id: int

struct ClockEventEdit: dict
    type = ClockMsgType.EVENT_EDIT
    clock_id: int
    id: int
    name: str
    when: int
    flags: ClockEventFlags


struct ClockEventDelete: dict
    type = ClockMsgType.EVENT_DELETE
    clock_id: int
    id: int

struct ClockClear: dict
    type = ClockMsgType.CLEAR
    id: int

union ClockMsg: dict
    ClockInitialize
    ClockShow
    ClockClear

    ClockNew
    ClockDelete
    ClockEdit

    ClockEventNew
    ClockEventEdit
    ClockEventDelete

enum StatItemType: int
    TABLE = 0
    MD = 1
    MACRO = 2
    IMG = 3
    VARIABLE = 4

struct StatTableItem: array
    name: str
    value: str

struct StatTable: array
    type = StatItemType.TABLE
    items: [StatTableItem]

struct StatMd: array
    type = StatItemType.MD
    value: str

struct StatMacro: array
    type = StatItemType.MACRO
    name: str
    value: str
    variables: [StatVariable]

struct StatVariable: array
    type = StatItemType.VARIABLE
    name: str
    kind: int
    value: str
    choices: [str]

struct StatImg: array
    type = StatItemType.IMG
    value: str

union StatItem: array
    StatTable
    StatMd
    StatMacro
    StatImg
    StatVariable

struct StatBlock: array
    id: int
    name: str
    contents: [StatItem]
    parent: int

validator: StatBlock
    ts
