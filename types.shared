# FromClient
# ----------
# Defines messages sent from the client to the server
enum FromClient: int
    # builtin
    # -------
    # CONNECT = connect

    # Core messages
    # -------------
    JOIN = 1
    POST_JOIN = 2
    # Chat messages
    # -------------
    CHAT_STRUCTURED_INPUT = 3
    CHAT_TEST_STRUCTURED_INPUT = 4
    # CHAT_PRIVATE_INPUT = 28
    CHAT_DM = 29
    # Roll Tables
    # -----------
    RETRIEVE_ROLL_TABLES = 5
    UPDATE_ROLL_TABLES = 6
    UPLOAD_ROLL_TABLE = 7
    # Canvas Messages
    # ---------------
    CANVAS_CREATE_OBJECTS = 8
    CANVAS_DELETE = 9
    CANVAS_UPDATE = 10
    CANVAS_GATHER = 11
    CANVAS_CREATE_MAP = 12
    CANVAS_PING = 13
    CANVAS_NAME_MAP = 14
    CANVAS_NEW_MAP_REQUEST = 15
    CANVAS_GRID_TYPE = 16
    CANVAS_GRID_NUMBERED = 17
    CANVAS_DELETE_MAP_REQUEST = 18
    CANVAS_BATTLE = 19
    CANVAS_DUNGEON_MODE = 20
    # Note messages
    # -------------
    GET_NOTE = 21
    NEW_NOTE_REQUEST = 22
    NOTE_UPDATE_TITLE = 23
    NOTE_UPDATE_BODY = 24
    DELETE_NOTE_REQUEST = 25
    # debugging
    # ---------
    DEBUG = 26
    # Settings
    # --------
    STORE_LOCAL_SETTING = 27

# ToClient
# --------
# Defines messages sent from the server to the client
enum ToClient: int
    # builtin
    # -------
    # CONNECT = connect
    # DISCONNECT = disconnect

    # Core messages
    # -------------
    SESSION_ID = 1
    TOKEN_PATHS = 2
    # Chat messages
    # -------------
    CHAT_CLEAR = 3
    CHAT_CREATE = 4
    CHAT_STRUCTURED_MSG = 5
    # CHAT_PRIVATE_STRUCTURED_MSG = 29
    CHAT_TEST_STRUCTURED_RESPONSE = 25
    CHAT_DIRECT_MSG = 30
    USER_LIST = 31
    USER_RENAME = 32
    CHAT_PRIVATE_CREATE = 33
    # Roll messages
    # -------------
    NEW_ROLL_TABLE = 6
    ROLL_TABLES = 26
    # Canvas
    # ------
    CANVAS_INITIALIZE_MAPS = 7
    CANVAS_CREATE_OBJECTS = 8
    CANVAS_DELETE = 9
    CANVAS_UPDATE = 10
    CANVAS_GATHER = 11
    CANVAS_CREATE_MAP = 12
    CANVAS_PING = 13
    CANVAS_NAME_MAP = 14
    CANVAS_GRID_TYPE = 15
    CANVAS_GRID_NUMBERED = 16
    CANVAS_DELETE_MAP = 17
    CANVAS_BATTLE = 18
    CANVAS_DUNGEON_MODE = 19
    # Notes
    NOTES_INITIALIZE = 20
    NEW_NOTE = 21
    NOTE_UPDATE_TITLE = 22
    NOTE_DIRTY = 23
    NOTE_DELETE = 24
    GOT_NOTE = 27
    NEW_NOTE_RESPONSE = 28


# ChatCommand
# -----------
# Commands. These are sent from the client to the server
enum ChatCommand: int
    ROLL = 0
    SAY = 1
    NAME = 2
    SHUFFLE = 3
    CHOOSE = 4
    TABLE = 5
    MYTABLE = 6

struct NameCommand: array
    type = ChatCommand.NAME
    name = str

struct RollCommand: array
    type = ChatCommand.ROLL
    original = str
    expr = UnrolledDiceExpr

struct SayCommand: array
    type = ChatCommand.SAY
    text = str

struct ShuffleCommand: array
    type = ChatCommand.SHUFFLE
    original = str
    items = [str]

struct ChooseCommand: array
    type = ChatCommand.CHOOSE
    original = str
    items = [str]

struct TableCommand: array
    type = ChatCommand.TABLE
    original = str
    table = str

struct MyTableCommand: array
    type = ChatCommand.MYTABLE
    original = str
    table = str

union Command: array
    NameCommand
    RollCommand
    SayCommand
    ShuffleCommand
    ChooseCommand
    TableCommand
    MyTableCommand

struct ChatCommandMessage: dict
    chatname = str
    commands = [Command]

struct ChatDirectCommandMessage: dict
    chatname = str
    to = int
    commands = [Command]

# DieExprTypes
# ------------
# Dice stuff. The different kinds of die
# groupings.
enum DieExprTypes: int
    NUMBER = 0 # Example: 4
    DICE   = 1 # Example: 2d6
    GROUP  = 2 # Example: (2d6+4)
    UNARY  = 3 # Example: -3
    BINARY = 4 # Example: d6*2

enum UNARY: int
    PLUS = 0 # +
    NEG = 1 # -
    NOT = 2 # !

enum BINARY: int
    ADD = 0 # +
    SUB = 1 # -
    MUL = 2 # *
    DIV = 3 # /
    EQ = 4  # =
    NE = 5  # !=
    GT = 6  # >
    GE = 7  # >=
    LT = 8  # <
    LE = 9  # <=

# RolledNumber
# ------------
# Server responds with rolled dice.
struct RolledNumber: array
    type = DieExprTypes.NUMBER
    value = int

struct RolledDice: array
    type = DieExprTypes.DICE
    n = int
    base = int
    values = [int]

struct RolledGroup: array
    type = DieExprTypes.GROUP
    value = RolledExpr

struct RolledUnary: array
    type = DieExprTypes.UNARY
    op = UNARY
    value = RolledExpr

struct RolledBinary: array
    type = DieExprTypes.BINARY
    op = BINARY
    left = RolledExpr
    right = RolledExpr

# RolledExpr
# ----------
# Use the type field to discriminate
union RolledExpr: array
    RolledNumber
    RolledDice
    RolledGroup
    RolledUnary
    RolledBinary

# Client sends unrolled dice
struct UnrolledDice: array
    type = DieExprTypes.DICE
    n = int
    base = int

struct UnrolledGroup: array
    type = DieExprTypes.GROUP
    value = UnrolledDiceExpr

struct UnrolledUnary: array
    type = DieExprTypes.UNARY
    op = UNARY
    value = UnrolledDiceExpr

struct UnrolledBinary: array
    type = DieExprTypes.BINARY
    op = BINARY
    left = UnrolledDiceExpr
    right = UnrolledDiceExpr

# UnrolledDiceExpr
# ----------------
# Use the type field to discriminate
union UnrolledDiceExpr: array
    RolledNumber
    UnrolledDice
    UnrolledGroup
    UnrolledUnary
    UnrolledBinary

# Msg
# ---
# Chat messages sent from the server to the client.
# These are in response to Commands
enum Msg: int
    PLAIN = 0
    # note:
    # Used to be DICEROLL = 1
    ERROR = 2
    # note:
    # used to be called DICEROLL_NEW
    DICEROLL = 3
    ECHOABLE_TEXT = 4

struct ChatPlainMsg: array
    type = Msg.PLAIN
    user = str
    data = str

struct ChatErrorMsg: array
    type = Msg.ERROR
    user = str
    data = str

struct ChatNewRollMsg: array
    type = Msg.DICEROLL
    user = str
    data = RolledExpr

struct ChatEchoableMsg: array
    type = Msg.ECHOABLE_TEXT
    user = str
    data = str

# ChatMsg
# -------
# The actual chat message union. Use the type field to discriminate.
union ChatMsg: array
    ChatPlainMsg
    ChatErrorMsg
    ChatNewRollMsg
    ChatEchoableMsg

struct ChatDirectResponse: dict
    users = [int]
    msgs = [ChatMsg]

# Roll table for the table command
# Tables are stored on the server, clients can create and update them.
enum ROLLTABLEFLAGS: int flag
    NONE = 0
    IS_TABLE = 1 << 0

struct RollTableEntry: dict
    weight = int
    value = str
    flags = ROLLTABLEFLAGS

struct RollTable: dict
    name = str
    id = int
    entries = [RollTableEntry]

struct RollTables: array
    shared = [RollTable]
    private = [RollTable]

# Canvas stuff

#
# Canvas Obj Types
# ================
enum CANVASTYPE: int
    FREEHAND_LINE = 1
    GRID_LINE     = 2
    RECT          = 3
    GRID_RECT     = 4
    FILLED_RECT   = 5
    ELLIPSE       = 6
    IMAGE         = 7
    TEXT          = 8
    EZ_TOKEN      = 9
    IMG_TOKEN     = 10
    DOOR          = 11
    STAIRS        = 12
    MEASURE       = 13
    FIXTURE       = 14
    FILLED_TILE   = 15
    TERRAIN_TILE  = 16
    ICON_TILE     = 17

#
# flags
enum CANVASFLAG: int flag
    NONE = 0
    DELETED = 1 << 0
    ALL = 1 << 0

//  freehand-line
//  -------------
//  Freehand lines are a bag of sequenced points that are
//  interpolated together with quadratic curves.
//  The server can optimize the lines by removing redundant
//  points.
struct StrippedFreehandLine: array
    type = CANVASTYPE.FREEHAND_LINE
    id = int
    base_x = float
    base_y = float
    flags = CANVASFLAG
    hidinguser = int # userid
    color = color
    # points are just raw x,y pairs in a flat array.
    points = [float]
    thickness = float

//  grid-line
//  ---------
//  A grid line are straight line-fragments whose points snap
//  to the corners of the grid.
//  Optimizing the points array is easy.
//  When moving this object, movements need to snap to the closest
//  grid point. When moving multiple objects, all of them need to snap
//  this way so that their relative positions are maintained.
struct StrippedGridLine: array
    type = CANVASTYPE.GRID_LINE
    id = int
    base_x = float
    base_y = float
    flags = CANVASFLAG
    hidinguser = int # userid
    color = color
    # points are just raw x,y pairs in a flat array.
    points = [float]

//  rectangle
//  ---------
//  An axis-aligned box.
//  base_x and base_y is the top-left corner of the box.
struct StrippedRectangle: array
    type = CANVASTYPE.RECT
    id = int
    base_x = float
    base_y = float
    flags = CANVASFLAG
    hidinguser = int # userid
    color = color
    width = float
    height = float

//  filled-rectangle
//  ---------
//  An axis-aligned box, but the center is filled with 'color2'
//  base_x and base_y is the top-left corner of the box.
struct StrippedFilledRectangle: array
    type = CANVASTYPE.FILLED_RECT
    id = int
    base_x = float
    base_y = float
    flags = CANVASFLAG
    hidinguser = int # userid
    color = color
    color2 = color
    width = float
    height = float

//  grid-rectangle
//  ---------
//  An axis-aligned box, whose corners snap to the grid.
//  Same movement restrictions apply to this as apply to the
//  grid-line.
//  base_x and base_y is the top-left corner of the box.
struct StrippedGridRectangle: array
    type = CANVASTYPE.GRID_RECT
    id = int
    base_x = float
    base_y = float
    flags = CANVASFLAG
    hidinguser = int # userid
    color = color
    width = float
    height = float

enum ELLIPSETYPE:int
    HOLLOW = 0
    SOLID = 1
    FILLED = 2

//  ellipse
//  -------
//  base_x and base_y is the center of the ellipse.
//  We only allow axis-aligned ellipses.
//
struct StrippedEllipse: array
    type = CANVASTYPE.ELLIPSE
    id = int
    base_x = float
    base_y = float
    flags = CANVASFLAG
    hidinguser = int # userid
    color = color
    color2 = color
    width = float
    height = float
    variant = ELLIPSETYPE

//  image
//  -----
struct StrippedImageObj: array
    type = CANVASTYPE.IMAGE
    id = int
    base_x = float
    base_y = float
    flags = CANVASFLAG
    hidinguser = int # userid
    width = float
    height = float
    url = str

enum TEXTALIGNMENT: int
    LEFT = 0
    CENTER = 1
    RIGHT = 2

//  text
//  ----
struct StrippedTextObj: array
    type = CANVASTYPE.TEXT
    id = int
    base_x = float
    base_y = float
    flags =  CANVASFLAG
    hidinguser = int # userid
    text = str
    size = float
    alignment = TEXTALIGNMENT
    map_id = int # -1 means no link

// TOKENSTATUSFLAGS
// ----------------
// status flags for conditions and status effects
// Bit flags
enum TOKENSTATUSFLAGS: int flag
    NONE       = 0
    ASLEEP     = 1 << 0
    BLESS      = 1 << 1
    BLIND      = 1 << 2
    CHARMED    = 1 << 3
    CONFUSED   = 1 << 4
    DEAF       = 1 << 5
    FEAR       = 1 << 6
    GRAPPLING  = 1 << 7
    HASTED     = 1 << 8
    INVISIBLE  = 1 << 9
    ONFIRE     = 1 << 10
    PARALYZED  = 1 << 11
    POISONED   = 1 << 12
    PRONE      = 1 << 13
    RESTRAINED = 1 << 14
    STUNNED    = 1 << 15

//  ez-token
//  --------
//  A token that just has a simple text label.
struct StrippedEzToken: array
    type = CANVASTYPE.EZ_TOKEN
    id = int
    base_x = float
    base_y = float
    flags = CANVASFLAG
    hidinguser = int # userid
    text = str
    color = color
    width = float # in squares (?)
    height = float # in squares (?)
    statusflags = TOKENSTATUSFLAGS

//  img-token
//  --------
//  A token that has an image as its contents.
struct StrippedImgToken: array
    type = CANVASTYPE.IMG_TOKEN
    id = int
    base_x = float
    base_y = float
    flags = CANVASFLAG
    hidinguser = int # userid
    url = str
    width = float # in squares (?)
    height = float # in squares (?)
    statusflags = TOKENSTATUSFLAGS

enum DOORTYPE: int
    DOOR = 0
    DOUBLE = 1
    PORTCULLIS = 2
    SECRET = 3
    BRICKED_WALL = 4
    PORTAL = 5
    CURTAINS = 6
    HALLWAY = 7

enum ORIENTATION: int
    VERTICAL = 0
    HORIZONTAL = 1
    TOPLEFT_DOWNRIGHT = 2
    TOPRIGHT_DOWNLEFT = 3

// door
// ----
// A door.
struct StrippedDoorObj: array
    type = CANVASTYPE.DOOR
    id = int
    base_x = float
    base_y = float
    flags = CANVASFLAG
    hidinguser = int # userid
    doortype = DOORTYPE
    color = color
    width = float # in squares (?)
    orientation = ORIENTATION

enum ROTATION: int
    # note: 
    # we might add the diagonals
    UP    = 0
    RIGHT = 2
    DOWN  = 4
    LEFT  = 6

struct StrippedStairs: array
    type = CANVASTYPE.STAIRS
    id = int
    base_x = float
    base_y = float
    flags = CANVASFLAG
    hidinguser = int # userid
    width = float # in squares
    height = float # in squares
    rotation = ROTATION

// Measure
// -------
// This is a weird object, but it is the measurement tool.
struct StrippedMeasureObj: array
    type = CANVASTYPE.MEASURE
    id = int
    base_x = float
    base_y = float
    flags = CANVASFLAG
    hidinguser = int # userid
    color = color
    x1 = float
    y1 = float

enum FIXTURETYPE: int
    STATUE = 0
    STAIRS = 1
    PIT = 2
    RUBBLE = 3

// Fixture
// ----------
// For dungeon fixtures, like rubble or pits.
struct StrippedFixtureObj: array
    type = CANVASTYPE.FIXTURE
    id = int
    base_x = float
    base_y = float
    flags = CANVASFLAG
    hidinguser = int # userid
    width = float
    height = float
    ftype = FIXTURETYPE

enum TILETYPE: int
    FILLED = 0
    TERRAIN = 1
    ICON = 2

// FilledTile
// ----------
struct StrippedFilledTile: array
    type = CANVASTYPE.FILLED_TILE
    id = int
    base_x = float
    base_y = float
    flags = CANVASFLAG
    hidinguser = int # userid
    color = color
    size = float

// TerrainTile
// -----------
struct StrippedTerrainTile: array
    type = CANVASTYPE.TERRAIN_TILE
    id = int
    base_x = float
    base_y = float
    flags = CANVASFLAG
    hidinguser = int # userid
    terrain_id = int

// IconTile
// --------
struct StrippedIconTile: array
    type = CANVASTYPE.ICON_TILE
    id = int
    base_x = float
    base_y = float
    flags = CANVASFLAG
    hidinguser = int # userid
    terrainicon_id = int

// StrippedObj
// -----------
//  Each object has a "stripped" representation, which is
//  the minimal amount of information for that object. For several types
//  this is the same as the regular one, but for others the unstripped
//  representation would include things like an HTMLImageElement.
//  Furthermore, the "stripped" representation can be converted to and from json,
//  so it can be shipped to and from the server.
//
// Intersection of all of the above types. They
// should share the following fields
//
//    type = CANVASTYPE
//    id = int
//    base_x = float
//    base_y = float
//    flags = CANVASFLAG
//    hidinguser = int # userid
//
// This allows most handling of the objects to work on the generic shared
// subset (like translating x pixels or setting a flag).

union StrippedObj: array
    StrippedFreehandLine
    StrippedGridLine
    StrippedRectangle
    StrippedGridRectangle
    StrippedFilledRectangle
    StrippedEllipse
    StrippedImageObj
    StrippedTextObj
    StrippedEzToken
    StrippedImgToken
    StrippedDoorObj
    StrippedStairs
    StrippedMeasureObj
    StrippedFixtureObj
    StrippedFilledTile
    StrippedTerrainTile
    StrippedIconTile


// GridType
// --------
enum GRIDTYPE: int flag
    SQUARE = 0 # square is default
    HEX = 1 << 0 # Hexes are drawn "odd-q" vertical layout
    NOGRID = 1 << 1 # NOGRID just means don't draw the grid.

enum MapFlags: int flag
    NONE = 0
    DELETED = 1 << 0
    CANT_DELETE = 1 << 1
    NUMBERED = 1 << 2

struct CreateObjectMessage: dict
    map_id = int
    object = StrippedObj

struct CreateObjectsMessage: dict
    map_id = int
    objects = [StrippedObj]

struct CanvasDeleteMessage: dict
    map_id = int
    ids = [int]

struct CanvasUpdateMessage: dict
    map_id = int
    obj_states = [StrippedObj]

struct NameMapMessage: dict
    map_id = int
    map_name = str

struct NewMapRequest: dict
    name = str
    grid_type  = GRIDTYPE
    flags = MapFlags

struct CanvasGridTypeMsg: dict
    map_id = int
    grid_type = GRIDTYPE
struct CanvasGridNumberedMsg: dict
    map_id = int
    numbered = MapFlags

struct NoteUpdateTitle: dict
    note_id = int
    title = str

struct NoteUpdateBody: dict
    note_id = int
    body = str

struct GatherMessage: dict
    x = int
    y = int
    map_id = int

struct PingData: dict
    cx = float
    cy = float
    color = color

struct PingMessage: dict
    ping = PingData
    map_id = int

struct InitializeMap: dict
    map_id = int
    map_name = str
    objects = [StrippedObj]
    flags = MapFlags
    grid_type = GRIDTYPE

enum NOTEFLAGS: int flag
    NONE = 0
    DELETED = 1

struct Note: dict
    title = str
    body = str
    flags = NOTEFLAGS
    id = int

struct LocalSetting: array
    category = str
    key = str
    value = str

struct UserListItem: array
    userid = int
    chatname = str

struct ChatHistory: array
    userid = int
    msgs = [ChatMsg]

message ToClientMsg: ToClient
    SESSION_ID = int
    TOKEN_PATHS = [str]
    CHAT_CLEAR = void
    CHAT_CREATE = [ChatMsg]
    CHAT_STRUCTURED_MSG = [ChatMsg]
    CHAT_TEST_STRUCTURED_RESPONSE = [ChatMsg]
    # CHAT_PRIVATE_STRUCTURED_MSG = [ChatMsg]
    CHAT_DIRECT_MSG = ChatDirectResponse
    USER_LIST = [UserListItem]
    USER_RENAME = UserListItem
    CHAT_PRIVATE_CREATE = [ChatHistory]
    # NEW_ROLL_TABLE = RollTables
    CANVAS_INITIALIZE_MAPS = [InitializeMap]
    CANVAS_CREATE_OBJECTS = [CreateObjectsMessage]
    CANVAS_DELETE = CanvasDeleteMessage
    CANVAS_UPDATE = CanvasUpdateMessage
    CANVAS_GATHER = GatherMessage
    CANVAS_CREATE_MAP = int
    CANVAS_PING = PingMessage
    CANVAS_NAME_MAP = NameMapMessage
    CANVAS_GRID_TYPE = CanvasGridTypeMsg
    CANVAS_GRID_NUMBERED = CanvasGridNumberedMsg
    CANVAS_DELETE_MAP = int
    CANVAS_BATTLE = GatherMessage
    CANVAS_DUNGEON_MODE = void
    NOTES_INITIALIZE = [Note]
    NEW_NOTE = int
    NOTE_UPDATE_TITLE = NoteUpdateTitle
    NOTE_DIRTY = int
    NOTE_DELETE = int
    ROLL_TABLES = RollTables
    GOT_NOTE = Note
    NEW_NOTE_RESPONSE = int

message FromClientMsg: FromClient
    JOIN = str
    POST_JOIN = void
    CHAT_STRUCTURED_INPUT = ChatCommandMessage
    CHAT_TEST_STRUCTURED_INPUT = ChatCommandMessage
    # CHAT_PRIVATE_INPUT = ChatCommandMessage
    CHAT_DM = ChatDirectCommandMessage
    RETRIEVE_ROLL_TABLES = void
    UPDATE_ROLL_TABLES = RollTables
    # UPLOAD_ROLL_TABLE = RollTable
    CANVAS_CREATE_OBJECTS = CreateObjectMessage
    CANVAS_DELETE = CanvasDeleteMessage
    CANVAS_UPDATE = CanvasUpdateMessage
    CANVAS_GATHER = GatherMessage
    CANVAS_CREATE_MAP = int
    CANVAS_PING = PingMessage
    CANVAS_NAME_MAP = NameMapMessage
    CANVAS_NEW_MAP_REQUEST = NewMapRequest
    CANVAS_GRID_TYPE = CanvasGridTypeMsg
    CANVAS_GRID_NUMBERED = CanvasGridNumberedMsg
    CANVAS_DELETE_MAP_REQUEST = int
    CANVAS_BATTLE = GatherMessage
    CANVAS_DUNGEON_MODE = void
    GET_NOTE = int
    NEW_NOTE_REQUEST = void
    NOTE_UPDATE_TITLE = NoteUpdateTitle
    NOTE_UPDATE_BODY = NoteUpdateBody
    DELETE_NOTE_REQUEST = int
    DEBUG = str
    STORE_LOCAL_SETTING = LocalSetting

enum DarkMode: int
    SYSTEM = 0
    DARK = 1
    LIGHT = 2

