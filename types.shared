# FromClient
# ----------
# Defines messages sent from the client to the server
enum FromClient: int
    # builtin
    # -------
    # CONNECT = connect

    # Core messages
    # -------------
    JOIN = 1
    POST_JOIN = 2
    # Chat messages
    # -------------
    CHAT_STRUCTURED_INPUT = 3
    CHAT_TEST_STRUCTURED_INPUT = 4
    # CHAT_PRIVATE_INPUT = 28
    CHAT_DM = 29
    # Roll Tables
    # -----------
    RETRIEVE_ROLL_TABLES = 5
    UPDATE_ROLL_TABLES = 6
    # UPLOAD_ROLL_TABLE = 7
    GET_ROLL_TABLE_NAMES = 30
    # Canvas Messages
    # ---------------
    CANVAS_CREATE_OBJECTS = 8
    CANVAS_DELETE = 9
    CANVAS_UPDATE = 10
    CANVAS_GATHER = 11
    CANVAS_CREATE_MAP = 12
    CANVAS_PING = 13
    CANVAS_NAME_MAP = 14
    CANVAS_NEW_MAP_REQUEST = 15
    CANVAS_GRID_TYPE = 16
    CANVAS_GRID_NUMBERED = 17
    CANVAS_GRID_COLOR = 31
    CANVAS_BG_COLOR = 32
    CANVAS_DELETE_MAP_REQUEST = 18
    CANVAS_BATTLE = 19
    CANVAS_DUNGEON_MODE = 20
    CANVAS_PARENT = 34
    # Note messages
    # -------------
    GET_NOTE = 21
    NEW_NOTE_REQUEST = 22
    NOTE_UPDATE_TITLE = 23
    NOTE_UPDATE_BODY = 24
    DELETE_NOTE_REQUEST = 25
    NOTE_SHOW = 33
    NOTE_PARENT = 35
    # debugging
    # ---------
    DEBUG = 26
    # Settings
    # --------
    STORE_LOCAL_SETTING = 27
    SPREADSHEET = 28

    METADATA = 36
    CALENDAR = 37

    CLOCK = 38

# ToClient
# --------
# Defines messages sent from the server to the client
enum ToClient: int
    # builtin
    # -------
    # CONNECT = connect
    # DISCONNECT = disconnect

    # Core messages
    # -------------
    SESSION_ID = 1
    # 2 was TOKEN_PATHS
    # Chat messages
    # -------------
    CHAT_CLEAR = 3
    CHAT_CREATE = 4
    CHAT_STRUCTURED_MSG = 5
    CHAT_TEST_STRUCTURED_RESPONSE = 25
    CHAT_DIRECT_MSG = 30
    USER_LIST = 31
    USER_RENAME = 32
    CHAT_PRIVATE_CREATE = 33
    # Roll messages
    # -------------
    NEW_ROLL_TABLE = 6
    ROLL_TABLES = 26
    ROLL_TABLE_NAMES = 34
    # Canvas
    # ------
    CANVAS_INITIALIZE_MAPS = 7
    CANVAS_CREATE_OBJECTS = 8
    CANVAS_DELETE = 9
    CANVAS_UPDATE = 10
    CANVAS_GATHER = 11
    CANVAS_CREATE_MAP = 12
    CANVAS_PING = 13
    CANVAS_NAME_MAP = 14
    CANVAS_GRID_TYPE = 15
    CANVAS_GRID_NUMBERED = 16
    CANVAS_GRID_COLOR = 36
    CANVAS_BG_COLOR = 37
    CANVAS_DELETE_MAP = 17
    CANVAS_BATTLE = 18
    CANVAS_DUNGEON_MODE = 19
    CANVAS_PARENT = 40
    # Notes
    NOTES_INITIALIZE = 20
    NEW_NOTE = 21
    NOTE_UPDATE_TITLE = 22
    NOTE_DIRTY = 23
    NOTE_DELETE = 24
    GOT_NOTE = 27
    NEW_NOTE_RESPONSE = 28
    NOTE_SHOW = 39
    NOTE_PARENT = 41
    # Init?
    API_VERSION = 35
    SPREADSHEET = 38

    METADATA = 42
    CALENDAR = 43
    CLOCK = 44


# ChatCommand
# -----------
# Commands. These are sent from the client to the server
enum ChatCommand: int
    ROLL = 0
    SAY = 1
    NAME = 2
    SHUFFLE = 3
    CHOOSE = 4
    TABLE = 5
    MYTABLE = 6
    STYLE = 7

struct NameCommand: array
    type = ChatCommand.NAME
    name: str

struct RollCommand: array
    type = ChatCommand.ROLL
    original: str
    expr: UnrolledDiceExpr

struct SayCommand: array
    type = ChatCommand.SAY
    text: str

struct ShuffleCommand: array
    type = ChatCommand.SHUFFLE
    original: str
    items: [str]

struct ChooseCommand: array
    type = ChatCommand.CHOOSE
    original: str
    items: [str]

struct TableCommand: array
    type = ChatCommand.TABLE
    original: str
    table: str

# This is for rolling private tables
struct MyTableCommand: array
    type = ChatCommand.MYTABLE
    original: str
    table: str

struct StyleCommand: array
    type = ChatCommand.STYLE
    text: str

union Command: array
    NameCommand
    RollCommand
    SayCommand
    ShuffleCommand
    ChooseCommand
    TableCommand
    MyTableCommand
    StyleCommand

struct ChatCommandMessage: dict
    chatname: str
    commands: [Command]

struct ChatDirectCommandMessage: dict
    chatname: str
    to: int
    commands: [Command]

# DieExprTypes
# ------------
# Dice stuff. The different kinds of die
# groupings.
enum DieExprTypes: int
    NUMBER = 0 # Example: 4
    DICE   = 1 # Example: 2d6
    GROUP  = 2 # Example: (2d6+4)
    Unary  = 3 # Example: -3
    Binary = 4 # Example: d6*2
    NGROUP = 5 # Example: 3(d6>1)

enum Unary: int
    PLUS = 0 # +
    NEG = 1 # -
    NOT = 2 # !

enum Binary: int
    ADD = 0 # +
    SUB = 1 # -
    MUL = 2 # *
    DIV = 3 # /
    EQ = 4  # =
    NE = 5  # !=
    GT = 6  # >
    GE = 7  # >=
    LT = 8  # <
    LE = 9  # <=

# RolledNumber
# ------------
# Server responds with rolled dice.
struct RolledNumber: array
    type = DieExprTypes.NUMBER
    value: int

struct RolledDice: array
    type = DieExprTypes.DICE
    n: int
    base: int
    values: [int]

struct RolledGroup: array
    type = DieExprTypes.GROUP
    value: RolledExpr

struct RolledUnary: array
    type = DieExprTypes.Unary
    op: Unary
    value: RolledExpr

struct RolledBinary: array
    type = DieExprTypes.Binary
    op: Binary
    left: RolledExpr
    right: RolledExpr

struct RolledNGroup: array
    type = DieExprTypes.NGROUP
    values: [RolledExpr]

# RolledExpr
# ----------
# Use the type field to discriminate
union RolledExpr: array
    RolledNumber
    RolledDice
    RolledGroup
    RolledUnary
    RolledBinary
    RolledNGroup

# Client sends unrolled dice
struct UnrolledDice: array
    type = DieExprTypes.DICE
    n: int
    base: int

struct UnrolledGroup: array
    type = DieExprTypes.GROUP
    value: UnrolledDiceExpr

struct UnrolledUnary: array
    type = DieExprTypes.Unary
    op: Unary
    value: UnrolledDiceExpr

struct UnrolledBinary: array
    type = DieExprTypes.Binary
    op: Binary
    left: UnrolledDiceExpr
    right: UnrolledDiceExpr

struct UnrolledNGroup: array
    type = DieExprTypes.NGROUP
    count: int
    expr: UnrolledDiceExpr

# UnrolledDiceExpr
# ----------------
# Use the type field to discriminate
union UnrolledDiceExpr: array
    RolledNumber
    UnrolledDice
    UnrolledGroup
    UnrolledUnary
    UnrolledBinary
    UnrolledNGroup

# Msg
# ---
# Chat messages sent from the server to the client.
# These are in response to Commands
enum Msg: int
    PLAIN = 0
    # note:
    # Used to be DICEROLL = 1
    ERROR = 2
    # note:
    # used to be called DICEROLL_NEW
    DICEROLL = 3
    ECHOABLE_TEXT = 4
    STYLED_TEXT = 5

struct ChatPlainMsg: array
    type = Msg.PLAIN
    user: str
    data: str

struct ChatErrorMsg: array
    type = Msg.ERROR
    user: str
    data: str

struct ChatNewRollMsg: array
    type = Msg.DICEROLL
    user: str
    data: RolledExpr

struct ChatEchoableMsg: array
    type = Msg.ECHOABLE_TEXT
    user: str
    data: str

enum StyleFlags: int flag
    NONE = 0
    COLORED = 1 << 0
    BOLD = 1 << 1
    ITALIC = 1 << 2
    ANON = 1 << 3
    UNDERLINE = 1 << 4
    BOXED = 1 << 5
    BIG = 1 << 6

struct StyledText: array
    text: str
    flags: StyleFlags
    color: color

struct ChatStyledMsg: array
    type = Msg.STYLED_TEXT
    user: str
    data: StyledText

# ChatMsg
# -------
# The actual chat message union. Use the type field to discriminate.
union ChatMsg: array
    ChatPlainMsg
    ChatErrorMsg
    ChatNewRollMsg
    ChatEchoableMsg
    ChatStyledMsg

struct ChatDirectResponse: dict
    users: [int]
    msgs: [ChatMsg]

# Roll table for the table command
# Tables are stored on the server, clients can create and update them.
enum RollTableFlags: int flag
    NONE = 0
    IS_TABLE = 1 << 0

struct RollTableEntry: dict
    weight: int
    value: str
    flags: RollTableFlags

struct RollTable: dict
    name: str
    id: int
    entries: [RollTableEntry]

struct RollTables: array
    shared: [RollTable]
    private: [RollTable]

# Canvas stuff

#
# Canvas Obj Types
# ================
enum CanvasType: int
    FREEHAND_LINE = 1
    GRID_LINE     = 2
    RECT          = 3
    GRID_RECT     = 4
    FILLED_RECT   = 5
    ELLIPSE       = 6
    IMAGE         = 7
    TEXT          = 8
    EZ_TOKEN      = 9
    IMG_TOKEN     = 10
    DOOR          = 11
    STAIRS        = 12
    MEASURE       = 13
    FIXTURE       = 14
    FILLED_TILE   = 15
    TERRAIN_TILE  = 16
    ICON_TILE     = 17
    SHAPE         = 19
    ARC           = 20
    COACHING      = 21

#
# flags
enum CanvasFlag: int flag
    NONE = 0
    DELETED = 1 << 0
    // A flag that is to be interpreted based on the object.
    FLAG_A = 1 << 1
    FLAG_B = 1 << 2
    FLAG_C = 1 << 3
    // Named versions of the above
    // ------
    // TEXT
    // FLAG_A is unused for text (was previously used)
    duplicate TEXT_LINKS_NOTE = FLAG_B
    duplicate TEXT_HAS_BACKGROUND = FLAG_C
    // FREEHAND_LINE
    duplicate LINE_IS_ARROW = FLAG_A
    // IMAGE
    duplicate IMG_IS_BACKGROUND = FLAG_A
    // SHAPE
    duplicate SHAPE_IS_POLYGON = FLAG_A
    duplicate SHAPE_IS_CONE = FLAG_B


//  freehand-line
//  -------------
//  Freehand lines are a bag of sequenced points that are
//  interpolated together with quadratic curves.
//  The server can optimize the lines by removing redundant
//  points.
struct StrippedFreehandLine: array
    type = CanvasType.FREEHAND_LINE
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    color: color
    # points are just raw x,y pairs in a flat array.
    points: [float]
    thickness: float

// CoachingLine
// ------------
// This is the same as a freehand line, but is drawn above
// everything else and there is a shortcut to clear all
// coaching lines.
struct StrippedCoachingLine: array
    type = CanvasType.COACHING
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    color: color
    # points are just raw x,y pairs in a flat array.
    points: [float]
    thickness: float

//  grid-line
//  ---------
//  A grid line are straight line-fragments whose points snap
//  to the corners of the grid.
//  Optimizing the points array is easy.
//  When moving this object, movements need to snap to the closest
//  grid point. When moving multiple objects, all of them need to snap
//  this way so that their relative positions are maintained.
struct StrippedGridLine: array
    type = CanvasType.GRID_LINE
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    color: color
    # points are just raw x,y pairs in a flat array.
    points: [float]

// shape
// -----
// A shape is a shape enclosed by an arbitrary sequence of points
struct StrippedShape: array
    type = CanvasType.SHAPE
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    color: color
    color2: color # can be empty, color of interior
    # points are just raw x,y pairs in a flat array.
    points: [float]
    thickness: float

//  rectangle
//  ---------
//  An axis-aligned box.
//  base_x and base_y is the top-left corner of the box.
struct StrippedRectangle: array
    type = CanvasType.RECT
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    color: color
    width: float
    height: float

//  filled-rectangle
//  ---------
//  An axis-aligned box, but the center is filled with 'color2'
//  base_x and base_y is the top-left corner of the box.
struct StrippedFilledRectangle: array
    type = CanvasType.FILLED_RECT
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    color: color
    color2: color
    width: float
    height: float

//  grid-rectangle
//  ---------
//  An axis-aligned box, whose corners snap to the grid.
//  Same movement restrictions apply to this as apply to the
//  grid-line.
//  base_x and base_y is the top-left corner of the box.
struct StrippedGridRectangle: array
    type = CanvasType.GRID_RECT
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    color: color
    width: float
    height: float

enum ELLIPSETYPE:int
    HOLLOW = 0
    SOLID = 1
    FILLED = 2

//  ellipse
//  -------
//  base_x and base_y is the center of the ellipse.
//  We only allow axis-aligned ellipses.
//
struct StrippedEllipse: array
    type = CanvasType.ELLIPSE
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    color: color
    color2: color
    width: float
    height: float
    variant: ELLIPSETYPE

//  image
//  -----
struct StrippedImageObj: array
    type = CanvasType.IMAGE
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    width: float
    height: float
    url: str

enum TextAlignment: int
    LEFT = 0
    CENTER = 1
    RIGHT = 2

//  text
//  ----
struct StrippedTextObj: array
    type = CanvasType.TEXT
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    text: str
    size: float
    alignment: TextAlignment
    # -1 means no link
    link_id: int

// TokenStatusFlags
// ----------------
// status flags for conditions and status effects
// Bit flags
enum TokenStatusFlags: int flag
    NONE            = 0
    ASLEEP          = 1 << 0
    BLESS           = 1 << 1
    BLIND           = 1 << 2
    CHARMED         = 1 << 3
    CONFUSED        = 1 << 4
    DEAF            = 1 << 5
    FEAR            = 1 << 6
    GRAPPLING       = 1 << 7
    HASTED          = 1 << 8
    INVISIBLE       = 1 << 9
    ONFIRE          = 1 << 10
    PARALYZED       = 1 << 11
    POISONED        = 1 << 12
    PRONE           = 1 << 13
    RESTRAINED      = 1 << 14
    STUNNED         = 1 << 15
    BLINK           = 1 << 16
    BLUR            = 1 << 17
    STRENGTH        = 1 << 18
    SHIELD_OF_FAITH = 1 << 19
    MARKED          = 1 << 20
    REACTED         = 1 << 21
    ACTED           = 1 << 22

//  ez-token
//  --------
//  A token that just has a simple text label.
struct StrippedEzToken: array
    type = CanvasType.EZ_TOKEN
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    text: str
    color: color
    width: float # in squares (?)
    height: float # in squares (?)
    statusflags: TokenStatusFlags
    hp: int
    maxhp: int

//  img-token
//  --------
//  A token that has an image as its contents.
struct StrippedImgToken: array
    type = CanvasType.IMG_TOKEN
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    url: str
    width: float # in squares (?)
    height: float # in squares (?)
    statusflags: TokenStatusFlags
    hp: int
    maxhp: int

enum DoorType: int
    DOOR = 0
    DOUBLE = 1
    PORTCULLIS = 2
    SECRET = 3
    BRICKED_WALL = 4
    PORTAL = 5
    CURTAINS = 6
    HALLWAY = 7
    WINDOW = 8

enum Orientation: int
    VERTICAL = 0
    HORIZONTAL = 1
    TOPLEFT_DOWNRIGHT = 2
    TOPRIGHT_DOWNLEFT = 3

// door
// ----
// A door.
struct StrippedDoorObj: array
    type = CanvasType.DOOR
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    doortype: DoorType
    color: color
    width: float # in squares (?)
    orientation: Orientation

enum Rotation: int
    UP         = 0
    UP_RIGHT   = 1
    RIGHT      = 2
    DOWN_RIGHT = 3
    DOWN       = 4
    DOWN_LEFT  = 5
    LEFT       = 6
    UP_LEFT    = 7

struct StrippedStairs: array
    type = CanvasType.STAIRS
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    width: float # in squares
    height: float # in squares
    rotation: Rotation

// Measure
// -------
// This is a weird object, but it is the measurement tool.
struct StrippedMeasureObj: array
    type = CanvasType.MEASURE
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    color: color
    x1: float
    y1: float

enum FixtureType: int
    STATUE = 0
    STAIRS = 1
    PIT = 2
    RUBBLE = 3
    WELL   = 4
    DIAG_STAIRS = 5

// Fixture
// ----------
// For dungeon fixtures, like rubble or pits.
struct StrippedFixtureObj: array
    type = CanvasType.FIXTURE
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    width: float
    height: float
    ftype: FixtureType

enum TileType: int
    FILLED = 0
    TERRAIN = 1
    ICON = 2

// FilledTile
// ----------
struct StrippedFilledTile: array
    type = CanvasType.FILLED_TILE
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    color: color
    size: float

// TerrainTile
// -----------
struct StrippedTerrainTile: array
    type = CanvasType.TERRAIN_TILE
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    terrain_id: int

// IconTile
// --------
struct StrippedIconTile: array
    type = CanvasType.ICON_TILE
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    terrainicon_id: int

struct StrippedArc: array
    type = CanvasType.ARC
    id: int
    base_x: float
    base_y: float
    flags: CanvasFlag
    hidinguser: int # userid
    width: float
    height: float
    start_arc: int
    end_arc: int
    thickness: float
    color: color


// StrippedObj
// -----------
//  Each object has a "stripped" representation, which is
//  the minimal amount of information for that object. For several types
//  this is the same as the regular one, but for others the unstripped
//  representation would include things like an HTMLImageElement.
//  Furthermore, the "stripped" representation can be converted to and from json,
//  so it can be shipped to and from the server.
//
// Intersection of all of the above types. They
// should share the following fields
//
//    type : CanvasType
//    id: int
//    base_x: float
//    base_y: float
//    flags: CanvasFlag
//    hidinguser: int # userid
//
// This allows most handling of the objects to work on the generic shared
// subset (like translating x pixels or setting a flag).

union StrippedObj: array
    StrippedFreehandLine
    StrippedGridLine
    StrippedRectangle
    StrippedGridRectangle
    StrippedFilledRectangle
    StrippedEllipse
    StrippedImageObj
    StrippedTextObj
    StrippedEzToken
    StrippedImgToken
    StrippedDoorObj
    StrippedStairs
    StrippedMeasureObj
    StrippedFixtureObj
    StrippedFilledTile
    StrippedTerrainTile
    StrippedIconTile
    StrippedShape
    StrippedArc
    StrippedCoachingLine

validator: StrippedObj
    ts

enum ScriptVariableType: int
    NUMBER = 0
    BOOLEAN = 1
    STRING = 2
    ABILITY_SCORE = 3 # 3.5 style
    CHOICE = 4

enum VariableUI: int flag
    NONE = 0
    SHOW_IN_PANEL = 1 << 0

struct Variable: array
    id: int
    name: str
    type: ScriptVariableType
    value: str
    ui: VariableUI
    values: [str]


struct Macro: array
    id: int
    name: str
    body: str
    variables: [int]

struct Character: array
    id: int
    name: str
    macros: [int]
    variables: [int]

// GridType
// --------
// It looks weird that you can have NOGRID and HEX set at the same time,
// but it just means to not draw the hex grid, you still do math
// and such on it.
enum GridType: int flag
    SQUARE = 0 # square is default
    HEX = 1 << 0 # Hexes are drawn "odd-q" vertical layout
    NOGRID = 1 << 1 # NOGRID just means don't draw the grid.

enum MapFlags: int flag
    NONE = 0
    DELETED = 1 << 0
    CANT_DELETE = 1 << 1
    NUMBERED = 1 << 2
    BIG_HEX = 1 << 3 // draw a big border around every 6th hex. Might make this also for squares in the future.

struct CreateObjectsMessage: dict
    map_id: int
    objects: [StrippedObj]

struct CanvasDeleteMessage: dict
    map_id: int
    ids: [int]

struct CanvasUpdateMessage: dict
    map_id: int
    obj_states: [StrippedObj]

struct CanvasParentMsg:dict
    map_id: int
    parent: int

struct NameMapMessage: dict
    map_id: int
    map_name: str

struct NewMapRequest: dict
    name: str
    grid_type : GridType
    flags: MapFlags
    grid_color: color
    bg_color: color
    parent: int

struct CanvasGridTypeMsg: dict
    map_id: int
    grid_type: GridType

# FIXME: wrong name, sets flags, not numbered
struct CanvasGridNumberedMsg: dict
    map_id: int
    numbered: MapFlags

struct CanvasColorMsg: dict
    map_id: int
    color: color

struct NoteUpdateTitle: dict
    note_id: int
    title: str

struct NewNoteMsg: dict
    note_id: int
    parent: int

struct NoteUpdateBody: dict
    note_id: int
    body: str

struct NoteParentMsg: dict
    note_id: int
    parent: int

struct GatherMessage: dict
    x: int
    y: int
    map_id: int

struct PingData: dict
    cx: float
    cy: float
    color: color

struct PingMessage: dict
    ping: PingData
    map_id: int

struct InitializeMap: dict
    map_id: int
    map_name: str
    objects: [StrippedObj]
    flags: MapFlags
    grid_type: GridType
    grid_color: color
    bg_color: color
    parent: int

enum NOTEFLAGS: int flag
    NONE = 0
    DELETED = 1

struct Note: dict
    title: str
    body: str
    flags: NOTEFLAGS
    id: int
    parent: int

struct LocalSetting: array
    category: str
    key: str
    value: str

struct UserListItem: array
    userid: int
    chatname: str

struct ChatHistory: array
    userid: int
    msgs: [ChatMsg]

struct RollTableNames: dict
    shared: [str]
    private: [str]

enum Api: int
    VERSION = 13

message ToClientMsg: ToClient
    // Unique id for generating object ids clientside.
    SESSION_ID = int
    // List of what tokens are available.
    CHAT_CLEAR = void
    CHAT_CREATE = [ChatMsg]
    CHAT_STRUCTURED_MSG = [ChatMsg]
    CHAT_TEST_STRUCTURED_RESPONSE = [ChatMsg]
    CHAT_DIRECT_MSG = ChatDirectResponse
    USER_LIST = [UserListItem]
    USER_RENAME = UserListItem
    CHAT_PRIVATE_CREATE = [ChatHistory]
    # NEW_ROLL_TABLE = RollTables
    CANVAS_INITIALIZE_MAPS = [InitializeMap]
