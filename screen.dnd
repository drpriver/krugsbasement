David20::title @hide
::div.map
  ::raw
    <canvas id="map"></canvas>
  ::div @id(tools)
    ::div.snaps
      ::raw
        <input type="radio" id="grid-snap-grid" name="snap-to-grid" value="GRID" checked>
        <label for="grid-snap-grid">Grid</label>
      ::raw
        <input type="radio" id="grid-snap-half" name="snap-to-grid" value="HALF">
        <label for="grid-snap-half">Half</label>
      ::raw
        <input type="radio" id="grid-snap-free" name="snap-to-grid" value="FREE">
        <label for="grid-snap-free" style">Free</label>
    ::div.tool @id(pan-tool)
      Pan
    ::div.tool
      Select
      ::raw
        <span>☰</span>
    ::div.tool
      Wall
    ::div.tool
      Door
      ::raw
        <span>☰</span>
    ::div.tool
      Stairs
    ::div.tool
      Line
    ::div.tool
      Rect
      ::raw
        <span>☰</span>
    ::div.tool
      Text
    ::div.tool
      Token
      ::raw
        <span>☰</span>
    ::div.tool
      Image
    ::div.tool
      Help
    ::div
      ::raw
        <input type="color" id="color-picker" value="#000000">
        <input type="color" id="color-picker2" value="#ffffff">
::div.chat @id(chat)
  ::div @id(tree)
    ::div
      ::raw
        <button id="edit-map-button">Edit Map</button>
        <button id="new-map-button">New Map</button>
    ::raw
      <select name="current-map-name" id="current-map-name">Untitled▾</select>
  ::div.log @id(chat-history)
  ::div @id(macros)
    ::raw
      <button id="chat-options">Options</button>
  ::raw
    <textarea id="chatinput" rows="4"></textarea>

::css @inline
  * {
    box-sizing: border-box;
  }
  #help-menu tbody tr td:nth-child(1){
    font-weight: bold;
    white-space: nowrap;
    border-right: 1px dotted #aaa;
  }
  #help-menu td{
    padding: 8px;
  }
  #help-menu {
    margin: 1em;
    max-width: 36em;
    border-collapse: collapse;
  }
  #help-menu tr {
    border-bottom: 1px solid black;
  }
  label {
    -webkit-user-select: none;
    user-select: none;
  }
  button {
    -webkit-user-select: none;
    user-select: none;
  }
  #tree {
    display: flex;
    flex-direction: column;
    border: 1px solid black;
    background-color: #fff;
    height: auto;
    min-height: 72px;
  }
  #tree > div {
    width: 100%;
    font-size: 24px;
    text-align: center;
  }
  button {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
  }
  #tree > select{
    width: 100%;
    margin: 4px 0px 4px 0px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
    font-size: 24px;
  }
  #tools{
    position: absolute;
    bottom: 5px;
    left: 5px;
    border: 2px solid black;
    padding: 4px;
    background-color: #fff;
    -webkit-user-select: none;
    user-select: none;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-column-gap: 4px;
    grid-row-gap: 4px;
  }
  #tools > div.tool {
    border: 1px solid gray;
    padding: 4px;
    cursor: pointer;
    background-color: #eee;
    box-shadow: 1px 1px 1px 1px rgba(0,0,0,0.3);
    /*border-radius: 4px;*/
    /*border-radius: 2px;*/
    text-align: center;
    font-family: "Helvetica Neue", "Segoe UI", sans-serif;
  }
  #tools > div.tool.selected {
    background-color: #fff;
    box-shadow: inset 1px 1px 1px 1px rgba(0,0,0,0.3);
  }
  #tools > div.tool:hover{
    background-color: #ccc;
  }
  #tools > div.tool.selected:hover {
    background-color: #f8f8f8;
  }
  #tools input[type="radio"]:checked+label {
    background-color: #fff;
    box-shadow: inset 1px 1px 1px 1px rgba(0,0,0,0.3);
  }
  #tools input[type="radio"]+label {
    background-color: #eee;
    box-shadow: 1px 1px 1px 1px rgba(0,0,0,0.3);
    border: 1px solid gray;
    cursor: pointer;
    padding: 4px;
  }
  #tools input[type="radio"] {
    display: none;
  }
  #tools > div.snaps {
    text-align: center;
    padding: 4px;
  }

  html{
    width: 100vw;
    height: 100vh;
  }
  html, body {
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
  }
  body > div {
    display: grid;
    grid-template-columns: auto 17em;
    grid-template-rows: 1fr;
    height: 100%;
    margin: 0;
  }
  .map {
    grid-column: 1;
    grid-row: 1;
    height: 100%;
  }
  #chat {
    grid-column: 2;
    grid-row: 1;
    height: 100vh;
    display: flex;
    flex-direction: column;
    border-left: 1px solid black;
  }
  #chat-history {
    overflow-y: scroll;
    /*height: 800px;*/
    /*width: 17em;*/
  }
  #chat-history div {
    border: 1px dotted gray;
    margin:-1px 0 0 -1px;
    padding: 2px 12px;
    font-family: "Helvetica Neue", "Segoe UI", sans-serif;
  }
  #macros{
    margin-top: auto;
  }
  .chat > textarea {
    resize: none;
  }
  canvas {
    -webkit-user-select: none;
    user-select: none;
  }
  section.menu {
    position: absolute;
    background-color: white;
    border: 1px solid black;
    box-shadow: 4px 4px rgba(0,0,0,0.18);
    border-radius: 3px;
    margin: 0;
    -webkit-user-select: none;
    user-select: none;
  }
  section.menuitem {
    padding: 4px 4px 4px 4px;
    font-family: "Helvetica Neue", "Segoe UI", sans-serif;
    cursor: pointer;
  }
  section.menuitem.disabled {
    color: gray;
  }
  section.menuitem:hover {
    background-color: #ccc;
  }
  section.hover {
    resize: both;
    position:absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 400px;
    min-height: 200px;
    background-color: white;
    border-radius: 8px;
    border: 1px solid black;
    box-shadow: 3px 3px 3px 3px rgba(0,0,0,0.3);
    font-family: sans-serif;
    overflow-y: auto;
    max-height: 90%;
  }
  section.hover input.numeric-input {
    width: 5em;
  }
  section.hover h2 {
    margin: auto;
    text-align: center;
    padding: 1em 1em 1em 1em;
  }
  section.hover > table.input-container {
    margin: auto;
  }
  section.hover input {
    border: 1px solid gray;
    padding: 4px 4px 4px 4px;
  }
  section.hover > div.hover-button-container {
    margin: auto;
    text-align: center;
    padding: 1em 1em 1em 1em;
  }
  div.dice-roll-msg{
  }
  span.dice-roll, span.dice-constant {
    font-size: 1.2em;
    vertical-align:middle;
    padding: 2px;
  }
  span.dice-total {
    font-size: 2em;
    vertical-align:middle;
    padding: 4px;
  }
  span.dice-roll-max {
    color: green;
  }
  span.dice-roll-min {
    color: red;
  }
  span.chat-error {
    color: #aa0000;
  }
  @media only screen and (max-width: 450px) {
    /* Turn the site into a diceroller. */
    #tools {
      display: none;
    }
    .map {
      display:none;
    }
    #chat {
      width: 100%;
    }
    #chat-history {
      width: 100%;
    }
    body > div {
      display: block;
    }
    section.hover {
      top: 0;
      left: 0;
      position: initial;
      transform: none;
      min-width: 0px;
    }
    .input-container textarea  {
      width: 200px;
    }
  }

  /*endcss*/
::js @noinline
  https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.0.1/socket.io.js
::js
  combined.js
