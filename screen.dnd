::css @inline
  * {
    box-sizing: border-box;
  }
  #help-menu tbody tr td:nth-child(1){
    font-weight: bold;
    white-space: nowrap;
  }
  #help-menu {
    margin: 1em;
    max-width: 36em;
  }
  button {
    user-select: none;
  }
  #top {
    position: absolute;
    top: 0px;
    left: 0px;
    background-color: #fff;
    font-size: 18px;
    font-family: "Helvetica Neue", "Segoe UI", sans-serif;
    border: 2px solid black;
    display: flex;
    flex-wrap: wrap;
    flex-direction: column;
    box-shadow: 1px 1px 1px 1px rgba(0,0,0,0.3);
    user-select: none;
    padding: 4px;
    max-width: 800px;
  }
  #top > div {
    display: inline-block;
    border: 1px solid gray;
    padding: 4px;
    cursor: pointer;
    background-color: #eee;
    box-shadow: 1px 1px 1px 1px rgba(0,0,0,0.3);
    border-radius: 4px;
    min-width: 1.5em;
    text-align: center;
    font-family: "Helvetica Neue", "Segoe UI", sans-serif;
  }
  #top > div.active-map {
    background-color: #aaa;
  }
  #tools{
    position: absolute;
    bottom: 5px;
    left: 80px;
    border: 2px solid black;
    padding: 4px;
    background-color: #fff;
    user-select: none;
  }
  #tools > div {
    display: inline-block;
    border: 1px solid gray;
    padding: 4px;
    cursor: pointer;
    background-color: #eee;
    box-shadow: 1px 1px 1px 1px rgba(0,0,0,0.3);
    border-radius: 4px;
    min-width: 3em;
    text-align: center;
    font-family: "Helvetica Neue", "Segoe UI", sans-serif;
  }
  #tools > div.selected {
    background-color: #fff;
    box-shadow: inset 1px 1px 1px 1px rgba(0,0,0,0.3);
  }
  #tools > div:hover {
    background-color: #ccc;
  }
  #tools > div.selected:hover {
    background-color: #f8f8f8;
  }
  html, body {
    height: 100%;
    margin: 0;
    padding: 0;
  }
  body > div {
    display: grid;
    grid-template-columns: auto 17em;
    grid-template-rows: 1fr;
    height: 100%;
    margin: 0;
  }
  .map {
    grid-column: 1;
    grid-row: 1;
    height: 100%;
  }
  #chat {
    grid-column: 2;
    grid-row: 1;
    height: 100%;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid black;
  }
  #chat-history {
    overflow-y: scroll;
    height: 800px;
    width: 17em;
  }
  #chat-history div {
    border: 1px dotted gray;
    margin:-1px 0 0 -1px;
    padding: 2px 12px;
    font-family: "Helvetica Neue", "Segoe UI", sans-serif;
  }
  .chat > textarea {
    grid-row: 2;
    resize: none;
  }
  canvas {
    user-select: none;
  }
  section.menu {
    position: absolute;
    background-color: white;
    border: 1px solid black;
    box-shadow: 4px 4px rgba(0,0,0,0.18);
    border-radius: 3px;
    margin: 0;
    user-select: none;
  }
  section.menuitem {
    padding: 4px 4px 4px 4px;
    font-family: "Helvetica Neue", "Segoe UI", sans-serif;
    cursor: pointer;
  }
  section.menuitem.disabled {
    color: gray;
  }
  section.menuitem:hover {
    background-color: #ccc;
  }
  section.hover {
    position:absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 400px;
    min-height: 200px;
    background-color: white;
    border-radius: 8px;
    border: 1px solid black;
    box-shadow: 3px 3px 3px 3px rgba(0,0,0,0.3);
    font-family: sans-serif;
    overflow-y: scroll;
    max-height: 90%;
  }
  section.hover input.numeric-input {
    width: 5em;
  }
  section.hover h2 {
    margin: auto;
    text-align: center;
    padding: 1em 1em 1em 1em;
  }
  section.hover > table.input-container {
    margin: auto;
  }
  section.hover input {
    border: 1px solid gray;
    padding: 4px 4px 4px 4px;
  }
  section.hover > div.hover-button-container {
    margin: auto;
    text-align: center;
    padding: 1em 1em 1em 1em;
  }
  div.dice-roll-msg{
  }
  span.dice-roll, span.dice-constant {
    font-size: 1.2em;
    vertical-align:middle;
    padding: 2px;
  }
  span.dice-total {
    font-size: 2em;
    vertical-align:middle;
    padding: 4px;
  }
  span.dice-roll-max {
    color: green;
  }
  span.dice-roll-min {
    color: red;
  }
  span.chat-error {
    color: #aa0000;
  }
  @media only screen and (max-width: 450px) {
    /* Turn the site into a diceroller. */
    #tools {
      display: none;
    }
    .map {
      display:none;
    }
    #chat {
      width: 100%;
    }
    #chat-history {
      width: 100%;
    }
    #top {
      display: none;
    }
    body > div {
      display: block;
    }
    section.hover {
      top: 0;
      left: 0;
      position: initial;
      transform: none;
      min-width: 0px;
    }
    .input-container textarea  {
      width: 200px;
    }
  }

  /*endcss*/
::js @noinline
  https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.0.1/socket.io.js
::js
  toplevel.js
  chat.js
  canvas.js

::js @inline
  function get(which){
    const link = document.createElement('a');
    if(which){
      link.download = which + '.json';
      link.href = '/state?which='+which;
    }
    else{
      link.download = 'state.json';
      link.href = '/state';
    }
    link.click();
  }
  function upload(){
    const inp = document.createElement('input');
    inp.type = 'file';
    function handlefiles(){
      const files = inp.files;
      if(!files.length)
        return;
      const file = files[0];
      fetch('/state', {
        method: 'POST',
        body: file,
      });
    }
    inp.addEventListener("change", handlefiles, false);
    inp.click();
  }
