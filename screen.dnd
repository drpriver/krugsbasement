::div.map
  ::raw
    <canvas id="map"></canvas>
::div.chat @id(chat)
  ::div.log @id(chat-history)
  ::raw
    <textarea id="chatinput"></textarea>
::div @id(tools)
  ::div
    Select
  ::div
    Pan
  ::div
    Line
  ::div
    Wall
  ::div
    Rect
  ::div
    Text
  ::div
    ::raw
      <input type="color" id="color-picker" name="color-picker", value="#ff3333"></input>
    
::css @inline
  * {
    box-sizing: border-box;
  }
  #tools{
    position: absolute;
    bottom: 5px;
    left: 80px;
    border: 2px solid black;
    padding: 4px;
    background-color: #fff;
  }
  #tools > div {
    display: inline-block;
    border: 1px solid grey;
    padding: 4px;
    cursor: pointer;
    background-color: #eee;
  }
  #tools > div.selected {
    background-color: #fff;
  }
  #tools > div:hover {
    background-color: #aaa;
  }
  #tools > div.selected:hover {
    background-color: #fff;
  }
  html, body {
    height: 100%;
    margin: 0;
    padding: 0;
  }
  body > div {
    display: grid;
    grid-template-columns: auto 14em;
    grid-template-rows: 1fr;
    height: 100%;
    margin: 0;
  }
  .map {
    grid-column: 1;
    grid-row: 1;
    height: 100%;
  }
  .chat {
    grid-column: 2;
    grid-row: 1;
    height: 100%;
    max-height: 100%;
    display: grid;
    grid-template-rows: auto 100px;
  }
  #chat-history {
    overflow-y: scroll;
    height: 800px;
    width: 14em;
  }
  #chat-history div {
    border: 1px dotted gray;
    margin:-1px 0 0 -1px;
  }
  .chat > textarea {
    grid-row: 2;
    resize: none;
  }
  canvas {
    border: 1px solid red;
  }
  /*endcss*/
::js @noinline
  https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.0.1/socket.io.js
::js @inline
  var socket = io();
  //endjs
::js
  chat.js
::js 
  canvas.js
