David20::title @hide
::raw
  <div id="disconnect" style="display:none;">
  You are currently not connected. Inputs will be buffered and sent upon
  reconnect.
  </div>
::div @id(editorcontainer)
  ::div @id(views)
    ::raw
      <canvas id="map"></canvas>
      <div id="right-split" style="display:none;"></div>

::div @id(tool-container)
  ::div @id(tools)
    ::div.tool @id(pan-tool)
      Pa<b>n</b>
    ::div.tool @id(select-tool)
      <b>S</b>elect
    ::div.tool-menu @id(select-tool-menu)
      ☰
    ::div.tool @id(wall-tool)
      W<b>a</b>ll
    ::div.tool @id(door-tool)
      <b>D</b>oor
    ::div.tool-menu @id(door-tool-menu)
      ☰
    ::div.tool @id(fixture-tool)
      <b>F</b>ixture
    ::div.tool-menu @id(fixture-tool-menu)
      ☰
    ::div.tool @id(line-tool)
      <b>L</b>ine
    ::raw
      <input type="number" id="line-thickness" value="4" max="20" min="1">
    ::div.tool @id(rect-tool)
      <b>R</b>ect
    ::div.tool-menu @id(rect-tool-menu)
      ☰
    ::div.tool @id(ellipse-tool)
      Elli<b>p</b>se
    ::div.tool-menu @id(ellipse-tool-menu)
      ☰
    ::div.tool @id(text-tool)
      <b>T</b>ext
    ::div.tool @id(token-tool)
      T<b>o</b>ken
    ::div.tool-menu @id(token-tool-menu)
      ☰
    ::div.tool @id(image-tool)
      <b>I</b>mage
    ::div.tool @id(tile-tool)
      Tile <b>k</b>
    ::div.tool-menu @id(tile-tool-menu)
      ☰
    ::div.tool @id(measure-tool)
      <b>M</b>easure
    ::div.tool @id(help-tool)
      Help
  ::div @id(stuff)
    ::div @id(colors)
      ::raw
        <input type="color" id="color-picker" value="#000000"><span id="color-picker-dropdown" style="cursor:pointer;width:2em;text-align:center;">▼</span>
        <input type="color" id="color-picker2" value="#ffffff"><span id="color-picker2-dropdown" style="cursor:pointer;width:2em;text-align:center;">▼</span>
    ::div.snaps
      ::raw
        <input type="radio" id="grid-snap-grid" name="snap-to-grid" value="GRID" checked>
        <label for="grid-snap-grid">Grid <b>Q</b></label>
        <input type="radio" id="grid-snap-half" name="snap-to-grid" value="HALF">
        <label for="grid-snap-half">Half <b>W</b></label>
        <input type="radio" id="grid-snap-free" name="snap-to-grid" value="FREE">
        <label for="grid-snap-free">Free <b>E</b></label>
::div @id(palette)
::div.chat @id(chat)
  ::div @id(tree)
    ::raw
      <table id="views-buttons-container" style="border-collapse: collapse">
        <tr style="border-bottom: 1px solid grey; max-width: 100%;">
          <td><span style="font-size:0.8rem;">Map</span>
          <td><select style="width: 60%; text-overflow:ellipsis;" name="current-map-name" id="current-map-name"></select>
            <button style="margin:0;" id="new-map-button"><span>+</style></button>
            <button style="margin:0;" id="edit-map-button">✎</button>
            <button style="margin:0;" id="delete-map-button">✘</button>
          </td>
        </tr>
        <tr style="border-bottom: 1px solid grey; max-width: 100%;">
          <td><span style="font-size:0.8rem;">Note</span>
          <td><select style="width: 60%; text-overflow:ellipsis;" name="current-note-name" id="current-note-name"><option>No Note</option></select>
            <button style="margin:0;" id="new-note-button">+</button>
            <button style="margin:0;" id="delete-note-button">✘</button>
          </td>
        </tr>
      </table>
  ::div.log @id(chat-history)
  ::div @id(macros)
    ::div @id(macro-tabs)
    ::div @id(macro-buttons)
    ::div @id(chat-buttons)
      ::raw
        <button id="chat-options">Options</button>
        <button id="macros-button">Macros</button>
  ::raw
    <textarea id="chatinput" rows="4"></textarea>

::css @inline
  :root {
    color-scheme: light dark; /* both supported */
  }
  * {
    box-sizing: border-box;
  }
  .tool b, .snaps b{
    /* wow this is a total hackjob */
    text-decoration: underline;
    font-weight: initial;
  }
  .tool {
    grid-column: 1;
  }
  .tool-menu {
    grid-column: 2;
  }
  #map {
    background-color: #fff;
    position: fixed;
    left: 0;
    top: 0;
  }
  #disconnect {
    background-color: red;
    font-size: 4em;
    position: absolute;
    top: 0px;
    left: 20%;
    max-width: 60%;
  }
  #help-menu tbody tr td:nth-child(1){
    font-weight: bold;
    white-space: nowrap;
    border-right: 1px dotted #aaa;
  }
  #help-menu tbody tr td:nth-child(2){
    white-space: nowrap;
    border-right: 1px dotted #aaa;
    font-family: monospace;
    text-align: center;
  }
  #help-menu td{
    padding: 8px;
  }
  #help-menu {
    margin: 1em;
    max-width: 60em;
    border-collapse: collapse;
  }
  #help-menu tr {
    border-bottom: 1px solid black;
  }
  #hover-conditions {
    display: grid;
    grid-template-rows: repeat(4, 1fr);
    grid-auto-flow: column;
  }
  label {
    -webkit-user-select: none;
    user-select: none;
  }
  button, button img {
    -webkit-user-select: none;
    user-select: none;
  }
  #token-img-gallery{
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    max-height: 512px;
    overflow-y: auto;
  }
  #views-buttons-container {
    width: 100%;
  }
  .view-buttons-separator {
    border-bottom: 1px solid gray;
  }

  #tree select{
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
  }
  #right-split{
    display: flex;
    flex-direction: column;
    justify-content: stretch;
    align-items: center;
    width: 300px;
    box-sizing: border-box;
  }
  #note-input{
    height: auto;
    font-size: 12px;
    font-weight: 800;
    resize: none;
    padding: .5em;
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
  }
  #note {
    flex-grow: 100;
    overflow-y: auto;
    padding: .5em;
    margin: 0;
    font-size: 12px;
    resize: none;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
  }
  #map{
    grid-column: 1
  }
  button {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
  }
  #palette{
    position: absolute;
    top: 5px;
    left: 5px;
    min-height: 200px;
    min-width: 200px;
    overflow-y: auto;
    border: 2px solid black;
    padding: 4px;
    background-color: #fff;
    -webkit-user-select: none;
    user-select: none;
    display: grid;
    grid-template-columns: repeat(6, auto);
    grid-column-gap: 4px;
    grid-row-gap: 4px;
  }
  #palette img {
    width: 25px;
    height: 25px;
  }
  #palette label {
    width: 40px;
    height: 40px;
  }

  #palette input[type="radio"]:checked+label {
    box-shadow: inset 2px 2px 2px 2px rgba(0,0,0,0.3);
    border: 2px solid red;
  }
  #palette input[type="radio"]+label {
    box-shadow: 1px 1px 1px 1px rgba(0,0,0,0.3);
    border: 1px solid gray;
    cursor: pointer;
    padding: 4px;
    width: 40px;
    height: 40px;
  }
  #palette input[type="radio"] {
    display: none;
    height: 40px;
  }
  #stuff{
    padding: 4px;
    -webkit-user-select: none;
    user-select: none;
    display: flex;
    flex-direction: column;
    font-size: 10px;
  }
  #tools{
    padding: 4px;
    -webkit-user-select: none;
    user-select: none;
    display: grid;
    grid-template-columns: 6em 5em;
    grid-column-gap: 0px;
    grid-row-gap: 0px;
    font-size: 10px;
    pointer-events: none;
  }
  #colors {
    display: flex;
    gap: 5px;
    align-content:center;
    justify-content: center;
    background-color: rgba(255, 255, 255);
    pointer-events: auto;
  }
  #tools input {
    padding: 0px;
  }
  #stuff input {
    pointer-events: auto;
    padding: 0px;
    max-width: 3em;
  }
  #tool-container {
    pointer-events: none;
    display: flex;
    flex-direction: column;
    position: absolute;
    bottom: 2px;
    left: 5px;
  }
  #tool-container label {
    pointer-events:auto;
  }
  div.tool-menu{
    white-space:nowrap;
    text-overflow: ellipsis;
  }
  div.tool {
  }
  #tools > div.tool , #tools > div.tool-menu{
    pointer-events: auto;
    border: 1px solid gray;
    padding: 4px;
    cursor: pointer;
    background-color: #eee;
    box-shadow: 1px 1px 1px 1px rgba(0,0,0,0.3);
    text-align: center;
    font-family: "Helvetica Neue", "Segoe UI", sans-serif;
  }
  #tools > div.tool.selected {
    background-color: #fff;
    box-shadow: inset 1px 1px 1px 1px rgba(0,0,0,0.3);
  }
  #tools > div.tool:hover{
    background-color: #ccc;
  }
  #tools > div.tool.selected:hover {
    background-color: #f8f8f8;
  }
  #stuff input[type="radio"]:checked+label {
    background-color: #fff;
    box-shadow: inset 1px 1px 1px 1px rgba(0,0,0,0.3);
  }
  #stuff input[type="radio"]+label {
    background-color: #eee;
    box-shadow: 1px 1px 1px 1px rgba(0,0,0,0.3);
    border: 1px solid gray;
    cursor: pointer;
    padding: 4px;
  }
  #stuff input[type="radio"] {
    display: none;
  }
  #stuff > div.snaps {
    text-align: center;
    padding: 4px;
  }
  #line-thickness {
    width: 4em;
    pointer-events: auto;
    grid-column: 2;
  }

  html{
    width: 100vw;
    height: 100vh;
  }
  html, body {
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
  }
  body {
    /*overflow: hidden;*/
  }
  body > div {
    display: grid;
    grid-template-columns: auto 17em;
    height: 100%;
    margin: 0;
  }
  #editorcontainer {
    grid-column: 1;
    grid-row: 1;
    height: 100%;
    display: grid;
  }
  #views {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
  }
  #chat {
    grid-column: 2;
    grid-row: 1;
    height: 100vh;
    display: flex;
    flex-direction: column;
    border-left: 1px solid black;
  }
  #chat-history {
    overflow-y: scroll;
    /*height: 800px;*/
    /*width: 17em;*/
  }
  #chat-history div {
    border: 1px dotted gray;
    margin:-1px 0 0 -1px;
    padding: 2px 12px;
    font-family: "Helvetica Neue", "Segoe UI", sans-serif;
  }
  #macros{
    margin-top: auto;
    display: flex;
    flex-direction: column;
    border-top: 1px solid black;
  }
  #macro-tabs {
    display: flex;
    align-items: stretch;
    width: 100%;
    padding: 0 .3em;
  }
  #macro-tabs > div {
    background-color: lightgray;
    border-top: 1px solid black;
    border-left: 1px solid black;
    border-right: 1px solid black;
    padding: 0 1em;
    margin-bottom: -1px;
    margin-right: -1px;
    -webkit-user-select: none;
    user-select: none;
    cursor: pointer;
    font-size: 12px;
    white-space: nowrap;
  }
  #macro-tabs > div.active {
    background-color: white;
    border-bottom: 2px solid white;
    z-index: 1;
  }
  #macro-buttons {
    border-top: 1px solid black;
    border-bottom: 1px solid black;
    height: 4em;
    overflow-y: auto;
  }
  .macro-group {
    display: grid;
    grid-template-columns: repeat(3, auto);
    max-width: 17em;
    padding-bottom: 6px;
    padding-top: 4px;
    grid-gap: 2px;
  }
  .macro-button {
    text-overflow:ellipsis;
    white-space: nowrap;
    -webkit-user-select: none;
    user-select: none;
  }
  #chat-buttons{
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-gap: 2px;
  }
  .chat > textarea {
    min-height: 4em;
    resize: none;
  }
  canvas {
    -webkit-user-select: none;
    user-select: none;
  }
  section.menu {
    position: absolute;
    background-color: white;
    border: 1px solid black;
    box-shadow: 4px 4px rgba(0,0,0,0.18);
    border-radius: 3px;
    margin: 0;
    -webkit-user-select: none;
    user-select: none;
  }
  section.menuitem, section.color-menuitem {
    padding: 4px 4px 4px 4px;
    font-family: "Helvetica Neue", "Segoe UI", sans-serif;
    cursor: pointer;
  }
  section.color-menuitem:hover {
    border: 2px solid yellow !important;
  }
  section.menuitem.disabled {
    color: gray;
  }
  section.menuitem:hover {
    background-color: #ccc;
  }
  section.hover {
    resize: both;
    position:absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 400px;
    min-height: 20%;
    background-color: white;
    border-radius: 8px;
    border: 1px solid black;
    box-shadow: 3px 3px 3px 3px rgba(0,0,0,0.3);
    font-family: sans-serif;
    overflow-y: auto;
    max-height: 90%;
  }
  section.hover input.numeric-input {
    width: 5em;
  }
  section.hover h2 {
    margin: auto;
    text-align: center;
    padding: 1em 1em 1em 1em;
  }
  section.hover > table.input-container {
    margin: auto;
  }
  section.hover input {
    border: 1px solid gray;
    padding: 4px 4px 4px 4px;
  }
  section.hover > div.hover-button-container {
    margin: auto;
    text-align: center;
    padding: 1em 1em 1em 1em;
  }
  #hover-tab-container {
  }
  #hover-tabs{
    display: flex;
    margin: 0 0.5em;
    align-items: stretch;
  }
  #hover-tabs > div {
    background-color: lightgray;
    border-top: 1px solid black;
    border-left: 1px solid black;
    border-right: 1px solid black;
    border-bottom: 1px solid black;
    padding: 0 1em;
    margin-bottom: -1px;
    margin-right: -1px;
    -webkit-user-select: none;
    user-select: none;
    cursor: pointer;
    text-align: center;
  }
  #hover-tabs > div.active {
    background-color: initial;
    border-bottom: 1px solid white;
    z-index: 1;
  }
  #hover-tab-contents {
    border-bottom: 1px solid black;
    border-left: 1px solid black;
    border-right: 1px solid black;
    border-top: 1px solid black;
    margin: 0 0.5em;
    height: 50vh;
    overflow-y: scroll;
  }
  #new-tab-input:not(:focus){
    background-color: lightgray;
  }
  div.up-down {
    display: grid;
    grid-template-rows: repeat(2, 1fr);
  }
  div.dice-roll-msg{
  }
  span.dice-roll, span.dice-constant {
    font-size: 1.2em;
    vertical-align:middle;
    padding: 2px;
  }
  span.dice-total {
    font-size: 2em;
    vertical-align:middle;
    padding: 4px;
  }
  span.dice-roll-max {
    color: green;
  }
  span.dice-roll-min {
    color: red;
  }
  span.chat-error {
    color: #aa0000;
  }
  body {
    background-color: #fff;
  }
  /*@media (prefers-color-scheme: dark) {*/
    body.dark-mode #map {
      background-color: #333;
    }
    body.dark-mode #tools {
      color: #000;
    }
    body.dark-mode {
      background-color: #333;
    }
    body.dark-mode #tools > div.tool {
      background-color: #888;
    }
    body.dark-mode #tools > div.tool-menu {
      background-color: #888;
    }
    body.dark-mode #tools > div.tool.selected {
      background-color: #eee;
    }
    body.dark-mode #tools > div.tool:hover{
      background-color: #aaa;
    }
    body.dark-mode #tools > div.tool.selected:hover {
      background-color: #ccc;
    }
    body.dark-mode #stuff input[type="radio"]:checked+label {
      background-color: #eee;
    }
    body.dark-mode #stuff input[type="radio"]:checked+label {
      background-color: #ccc;
    }
    body.dark-mode #stuff input[type="radio"]+label {
      background-color: #888;
    }
    body.dark-mode #stuff input[type="radio"]+label:hover {
      background-color: #aaa;
    }
    body.dark-mode section.menu {
      background-color: #333;
      color: #aaa;
    }
    body.dark-mode section.menuitem:hover {
      background-color: #666;
    }
    body.dark-mode section.hover {
      background-color: #666;
    }
    body.dark-mode #hover-tabs > div.active {
      border-bottom: 1px solid #666;
      background-color: #666;
    }
    body.dark-mode #hover-tabs > div {
      background-color: #505050;
      color: white;
    }
    body.dark-mode #macro-tabs > div.active {
      border-bottom: 1px solid #666;
      background-color: #666;
    }
    body.dark-mode #macro-tabs > div {
      background-color: #505050;
      color: white;
    }
    body.dark-mode #chat{
      color: #aaa;
    }
    body.dark-mode #palette {
      background-color: #333;
    }
    body.dark-mode #colors {
      background-color: #333;
    }
  /*}*/
  @media only screen and (max-width: 450px) {
    /* Turn the site into a diceroller. */
    #tools {
      display: none;
    }
    #editorcontainer {
      display:none;
    }
    #chat {
      width: 100%;
    }
    #chat-history {
      width: 100%;
    }
    body > div {
      display: block;
    }
    section.hover {
      top: 0;
      left: 0;
      position: initial;
      transform: none;
      min-width: 0px;
    }
    .input-container textarea  {
      width: 200px;
    }
  }

  /*endcss*/
::js @noinline
  https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.0.1/socket.io.js
::js
  combined.js
