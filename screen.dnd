::div.map
  ::raw
    <canvas id="map"></canvas>
  ::div @id(tools)
    ::div
      Pan
    ::div
      Select
      ::raw
        <span></span>
        <span>☰</span>
    ::div
      Move
    ::div
      Line
    ::div
      Rect
    ::div
      Wall
    ::div
      Floor
    ::div
      Text
    ::div
      Ez-Token
    ::div
      Img-Token
    ::div
      Image
    ::div
      ::raw
        <input type="color" id="color-picker" name="color-picker", value="#ff3333"></input>
::div.chat @id(chat)
  ::div.log @id(chat-history)
  ::raw
    <textarea id="chatinput"></textarea>
    
::css @inline
  * {
    box-sizing: border-box;
  }
  #tools{
    position: absolute;
    bottom: 5px;
    left: 80px;
    border: 2px solid black;
    padding: 4px;
    background-color: #fff;
  }
  #tools > div {
    display: inline-block;
    border: 1px solid gray;
    padding: 4px;
    cursor: pointer;
    background-color: #eee;
    box-shadow: 1px 1px 1px 1px rgba(0,0,0,0.3);
    border-radius: 4px;
    min-width: 3em;
    text-align: center;
    font-family: "Helvetica Neue", "Segoe UI", sans-serif;
  }
  #tools > div.selected {
    background-color: #fff;
    box-shadow: inset 1px 1px 1px 1px rgba(0,0,0,0.3);
  }
  #tools > div:hover {
    background-color: #ccc;
  }
  #tools > div.selected:hover {
    background-color: #f8f8f8;
  }
  html, body {
    height: 100%;
    margin: 0;
    padding: 0;
  }
  body > div {
    display: grid;
    grid-template-columns: auto 14em;
    grid-template-rows: 1fr;
    height: 100%;
    margin: 0;
  }
  .map {
    grid-column: 1;
    grid-row: 1;
    height: 100%;
  }
  .chat {
    grid-column: 2;
    grid-row: 1;
    height: 100%;
    max-height: 100%;
    display: grid;
    grid-template-rows: auto 100px;
  }
  #chat-history {
    overflow-y: scroll;
    height: 800px;
    width: 14em;
  }
  #chat-history div {
    border: 1px dotted gray;
    margin:-1px 0 0 -1px;
    font-family: "Helvetica Neue", "Segoe UI", sans-serif;
  }
  .chat > textarea {
    grid-row: 2;
    resize: none;
  }
  canvas {
    border: 1px solid red;
  }
  section.menu {
    position: absolute;
    background-color: white;
    border: 1px solid black;
    box-shadow: 4px 4px rgba(0,0,0,0.18);
    border-radius: 3px;
    margin: 0;
  }
  section.menuitem {
    border: 1px solid black;
    padding: 4px 4px 4px 4px;
    margin: -1px 0 0 -1px;
    font-family: "Helvetica Neue", "Segoe UI", sans-serif;
    cursor: pointer;
  }
  section.menuitem:hover {
    background-color: #ccc;
  }
  /*endcss*/
::js @noinline
  https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.0.1/socket.io.js
::js
  toplevel.js
  chat.js
  canvas.js
