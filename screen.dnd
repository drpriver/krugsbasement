::css
  :root {
    color-scheme: light dark; /* both supported */
  }
  * {
    box-sizing: border-box;
  }
  .tool b, .scale b{
    /* wow this is a total hackjob */
    text-decoration: underline;
    font-weight: initial;
  }
  .tool {
    grid-column: 1;
  }
  .tool-menu {
    grid-column: 2;
  }
  #map {
    background-color: #fff;
    position: fixed;
    left: 0;
    top: 0;
  }
  #disconnect {
    background-color: red;
    font-size: 4em;
    position: fixed;
    top: 0px;
    left: 20%;
    max-width: 60%;
  }
  #help-menu tbody tr td:nth-child(1){
    font-weight: bold;
    white-space: nowrap;
    border-right: 1px dotted #aaa;
  }
  #help-menu tbody tr td:nth-child(2){
    white-space: nowrap;
    border-right: 1px dotted #aaa;
    font-family: monospace;
    text-align: center;
  }
  #help-menu td{
    padding: 8px;
  }
  #help-menu {
    margin: 1em;
    max-width: 60em;
    border-collapse: collapse;
  }
  #help-menu tr {
    border-bottom: 1px solid black;
  }
  #ez-token-conditions, #img-token-conditions {
    display: grid;
    grid-template-rows: repeat(4, 1fr);
    grid-auto-flow: column;
  }
  label {
    -webkit-user-select: none;
    user-select: none;
  }
  button, button img {
    -webkit-user-select: none;
    user-select: none;
  }
  #img-token-gallery{
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    max-height: 512px;
    overflow-y: auto;
  }
  #views-buttons-container {
    width: 100%;
  }

  #tree select{
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
  }
  #note-input{
    height: auto;
    font-size: 12px;
    font-weight: 800;
    resize: none;
    padding: .5em;
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
  }
  #note {
    flex-grow: 100;
    overflow-y: auto;
    padding: .5em;
    margin: 0;
    font-size: 12px;
    resize: none;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
  }
  #map{
    grid-column: 1
  }
  button {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
  }
  #palette{
    position: fixed;
    top: 5px;
    left: 5px;
    min-height: 200px;
    min-width: 200px;
    overflow-y: auto;
    border: 2px solid black;
    padding: 4px;
    background-color: #fff;
    -webkit-user-select: none;
    user-select: none;
    display: grid;
    grid-template-columns: repeat(6, auto);
    grid-column-gap: 4px;
    grid-row-gap: 4px;
  }
  #palette img {
    width: 25px;
    height: 25px;
  }
  #palette label {
    width: 40px;
    height: 40px;
  }

  #palette input[type="radio"]:checked+label {
    box-shadow: inset 2px 2px 2px 2px rgba(0,0,0,0.3);
    border: 2px solid red;
  }
  #palette input[type="radio"]+label {
    box-shadow: 1px 1px 1px 1px rgba(0,0,0,0.3);
    border: 1px solid gray;
    cursor: pointer;
    padding: 4px;
    width: 40px;
    height: 40px;
  }
  #palette input[type="radio"] {
    display: none;
    height: 40px;
  }
  #stuff{
    padding: 4px;
    -webkit-user-select: none;
    user-select: none;
    display: flex;
    flex-direction: column;
    font-size: 10px;
  }
  #tools{
    padding: 4px;
    -webkit-user-select: none;
    user-select: none;
    display: grid;
    grid-template-columns: 6em 5em;
    grid-column-gap: 0px;
    grid-row-gap: 0px;
    font-size: 10px;
    pointer-events: none;
  }
  #colors {
    display: flex;
    gap: 5px;
    align-content:center;
    justify-content: center;
    background-color: rgba(255, 255, 255);
    pointer-events: auto;
  }
  #tools input {
    padding: 0px;
  }
  #stuff input {
    pointer-events: auto;
    padding: 0px;
    max-width: 3em;
  }
  #tool-container {
    pointer-events: none;
    display: flex;
    flex-direction: column;
    position: fixed;
    bottom: 2px;
    left: 5px;
  }
  #tool-container label {
    pointer-events:auto;
  }
  div.tool-menu{
    white-space:nowrap;
    text-overflow: ellipsis;
  }
  div.tool {
  }
  #tools > div.tool , #tools > div.tool-menu{
    pointer-events: auto;
    border: 1px solid gray;
    padding: 4px;
    cursor: pointer;
    background-color: #eee;
    box-shadow: 1px 1px 1px 1px rgba(0,0,0,0.3);
    text-align: center;
    font-family: "Helvetica Neue", "Segoe UI", sans-serif;
  }
  #tools > div.tool.selected {
    background-color: #fff;
    box-shadow: inset 1px 1px 1px 1px rgba(0,0,0,0.3);
  }
  #tools > div.tool:hover{
    background-color: #ccc;
  }
  #tools > div.tool.selected:hover {
    background-color: #f8f8f8;
  }
  #stuff input[type="radio"]:checked+label {
    background-color: #fff;
    box-shadow: inset 1px 1px 1px 1px rgba(0,0,0,0.3);
  }
  #stuff input[type="radio"]+label {
    background-color: #eee;
    box-shadow: 1px 1px 1px 1px rgba(0,0,0,0.3);
    border: 1px solid gray;
    cursor: pointer;
    padding: 4px;
  }
  #stuff input[type="radio"] {
    display: none;
  }
  div.scale {
    text-align: center;
    padding: 4px;
    height: auto;
    display: grid;
    grid-template-rows: 1fr 1fr;
    grid-template-columns: auto 1fr 1fr 1fr 1fr;
    align-items: center;
  }
  div.scale div {
    background-color: #eee;
    padding: 5px;
  }
  #line-thickness {
    width: 4em;
    pointer-events: auto;
    grid-column: 2;
  }

  html{
    width: 100vw;
    height: 100vh;
  }
  html, body {
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
    height: 100%;
  }
  html, body {
    /*overflow: hidden;*/
  }
  body > div {
    display: grid;
    grid-template-columns: auto 17em;
    height: 100%;
    margin: 0;
  }
  #chat {
    grid-column: 2;
    grid-row: 1;
    height: 100vh;
    display: flex;
    flex-direction: column;
    border-left: 1px solid black;
    overflow-wrap: break-word;
  }
  #chat-history {
    overflow-y: scroll;
    /*height: 800px;*/
    /*width: 17em;*/
  }
  #chat-history div {
    border: 1px dotted gray;
    margin:-1px 0 0 -1px;
    padding: 2px 12px;
    font-family: "Helvetica Neue", "Segoe UI", sans-serif;
  }
  #macros{
    margin-top: auto;
    display: flex;
    flex-direction: column;
    border-top: 1px solid black;
  }
  #macro-tabs {
    display: flex;
    align-items: stretch;
    width: 100%;
    padding: 0 .3em;
  }
  #macro-tabs > div {
    background-color: lightgray;
    border-top: 1px solid black;
    border-left: 1px solid black;
    border-right: 1px solid black;
    padding: 0 1em;
    margin-bottom: -1px;
    margin-right: -1px;
    -webkit-user-select: none;
    user-select: none;
    cursor: pointer;
    font-size: 12px;
    white-space: nowrap;
  }
  #macro-tabs > div.active {
    background-color: white;
    border-bottom: 2px solid white;
    z-index: 1;
  }
  #macro-buttons {
    border-top: 1px solid black;
    border-bottom: 1px solid black;
    height: 4em;
    overflow-y: auto;
  }
  .macro-group {
    display: grid;
    grid-template-columns: repeat(3, auto);
    max-width: 17em;
    padding-bottom: 6px;
    padding-top: 4px;
    grid-gap: 2px;
  }
  .macro-button {
    text-overflow:ellipsis;
    white-space: nowrap;
    -webkit-user-select: none;
    user-select: none;
  }
  .three-buttons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-gap: 2px;
    width: 100%;
  }
  .chat > textarea {
    min-height: 4em;
    resize: none;
  }
  canvas {
    -webkit-user-select: none;
    user-select: none;
  }
  section.menu {
    position: absolute;
    background-color: white;
    border: 1px solid black;
    box-shadow: 4px 4px rgba(0,0,0,0.18);
    border-radius: 3px;
    margin: 0;
    -webkit-user-select: none;
    user-select: none;
  }
  section.menuitem, section.color-menuitem {
    padding: 4px 4px 4px 4px;
    font-family: "Helvetica Neue", "Segoe UI", sans-serif;
    cursor: pointer;
  }
  section.color-menuitem:hover {
    border: 2px solid yellow !important;
  }
  section.menuitem.disabled {
    color: gray;
  }
  section.menuitem:hover {
    background-color: #ccc;
  }
  div.hover, section.hover {
    resize: both;
    position:fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 400px;
    min-height: 20%;
    background-color: white;
    border-radius: 8px;
    border: 1px solid black;
    box-shadow: 3px 3px 3px 3px rgba(0,0,0,0.3);
    font-family: sans-serif;
    overflow-y: auto;
    max-height: 90%;
    z-index: 16777216;
  }
  div.hover input.numeric-input, section.hover input.numeric-input {
    width: 5em;
  }
  div.hover h2, section.hover h2 {
    margin: auto;
    text-align: center;
    padding: 1em 1em 1em 1em;
  }
  div.hover > table.input-container, section.hover > table.input-container {
    margin: auto;
  }
  div.hover input, section.hover input {
    border: 1px solid gray;
    padding: 4px 4px 4px 4px;
  }
  div.hover-button-container {
    margin: auto;
    text-align: center;
    padding: 1em 1em 1em 1em;
  }
  #hover-tab-container {
  }
  #hover-tabs{
    display: flex;
    margin: 0 0.5em;
    align-items: stretch;
  }
  #hover-tabs > div {
    background-color: lightgray;
    border-top: 1px solid black;
    border-left: 1px solid black;
    border-right: 1px solid black;
    border-bottom: 1px solid black;
    padding: 0 1em;
    margin-bottom: -1px;
    margin-right: -1px;
    -webkit-user-select: none;
    user-select: none;
    cursor: pointer;
    text-align: center;
  }
  #hover-tabs > div.active {
    background-color: initial;
    border-bottom: 1px solid white;
    z-index: 1;
  }
  #hover-tab-contents {
    border-bottom: 1px solid black;
    border-left: 1px solid black;
    border-right: 1px solid black;
    border-top: 1px solid black;
    margin: 0 0.5em;
    height: 50vh;
    overflow-y: scroll;
  }
  #new-tab-input:not(:focus){
    background-color: lightgray;
  }
  div.up-down {
    display: grid;
    grid-template-rows: repeat(2, 1fr);
  }
  div.dice-roll-msg{
  }
  span.dice-roll, span.dice-constant {
    font-size: 1.2em;
    vertical-align:middle;
    padding: 2px;
  }
  span.dice-total {
    font-size: 2em;
    vertical-align:middle;
    padding: 4px;
  }
  span.dice-roll-max {
    color: green;
  }
  span.dice-roll-min {
    color: red;
  }
  span.chat-error {
    color: #aa0000;
  }
  body {
    background-color: #fff;
  }
  div.rolltable table{
    margin: auto;
  }
  /*@media (prefers-color-scheme: dark) {*/
    body.dark-mode #map {
      background-color: #333;
    }
    body.dark-mode #tools {
      color: #000;
    }
    body.dark-mode {
      background-color: #333;
    }
    body.dark-mode #tools > div.tool {
      background-color: #888;
    }
    body.dark-mode #tools > div.tool-menu {
      background-color: #888;
    }
    body.dark-mode #tools > div.tool.selected {
      background-color: #eee;
    }
    body.dark-mode #tools > div.tool:hover{
      background-color: #aaa;
    }
    body.dark-mode #tools > div.tool.selected:hover {
      background-color: #ccc;
    }
    body.dark-mode #stuff input[type="radio"]:checked+label {
      background-color: #333;
    }
    body.dark-mode #stuff input[type="radio"]+label {
      background-color: #888;
    }
    body.dark-mode #stuff input[type="radio"]+label:hover {
      background-color: #666;
    }
    body.dark-mode div.scale div {
      background-color: #888;
    }
    body.dark-mode section.menu {
      background-color: #333;
      color: #aaa;
    }
    body.dark-mode section.menuitem:hover {
      background-color: #666;
    }
    body.dark-mode div.hover, body.dark-mode section.hover {
      background-color: #666;
    }
    body.dark-mode #hover-tabs > div.active {
      border-bottom: 1px solid #666;
      background-color: #666;
    }
    body.dark-mode #hover-tabs > div {
      background-color: #505050;
      color: white;
    }
    body.dark-mode #macro-tabs > div.active {
      border-bottom: 1px solid #666;
      background-color: #666;
    }
    body.dark-mode #macro-tabs > div {
      background-color: #505050;
      color: white;
    }
    body.dark-mode #chat{
      color: #aaa;
    }
    body.dark-mode #palette {
      background-color: #333;
    }
    body.dark-mode #colors {
      background-color: #333;
    }
    body.dark-mode .window {
      background-color: #333;
    }
    body.dark-mode .window-handle, body.dark-mode #tool-container-handle {
      background-color: #444;
    }
    body.dark-mode .window-group-list div {
      color: #aaa;
      background-color: #111;
    }
    body.dark-mode .window-group-list div:hover {
      background-color: #113;
    }
    body.dark-mode .window-group-list div.active:hover {
      background-color: #446;
    }
    body.dark-mode .window-group-list div.active {
      background-color: #335;
    }
    body.dark-mode .window-closer:hover {
      background-color: rgba(255, 255, 255, 0.1);
    }
    @supports (-moz-appearance:none) {
      body.dark-mode textarea {
        color: #aaa;
        background-color: #333;
      }
    }
  /*}*/
  @media only screen and (max-width: 450px) {
    /* Turn the site into a diceroller. */
    #tools, #stuff{
      display: none;
    }
    #chat {
      width: 100%;
    }
    #chat-history {
      width: 100%;
    }
    body > div {
      display: block;
    }
    div.hover, section.hover {
      top: 0;
      left: 0;
      position: initial;
      transform: none;
      min-width: 0px;
    }
    .input-container textarea  {
      width: 200px;
    }
  }
  @media only screen and (max-height: 450px) {
    * {
      font-size: 0.5rem;
    }
    input [type="radio"], .tool, .tool-menu, #stuff *{
      height: auto !important;
      font-size: 8px !important;
      padding: 0px !important;
    }
  }
  #tool-container, #palette{
    touch-action: none;
  }
  /*endcss*/
::script #noinline
  https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.0.1/socket.io.js
::script #import
  combined.js
