David20::title #hide
::raw
  <div id="disconnect" style="display:none;">
  You are currently not connected. Inputs will be buffered and sent upon
  reconnect.
  </div>
::css
  .window {
    position: fixed;
    top: 10%;
    left: 10%;
    z-index: 4;
    resize: both;
    overflow: auto;
    flex-direction: row;
    grid-template-rows: 32px auto;
    height: auto;
    padding: 0px;
    border-radius: 8px 8px 8px 8px;
    box-shadow: 3px 3px 3px 3px rgba(0,0,0,0.3);
    background-color: white;
    -webkit-user-select: none;
    user-select: none;
  }
  .window-handle {
    grid-row: 1;
    cursor: grab;
    background-color: rgb(221,221,221);
    border-radius: 8px 8px 0px 0px;
    display: grid;
    grid-template-columns: 48px auto 48px;
    height: 32px;
    min-width: 32px;
  }
  #tool-container-handle {
    cursor: grab;
    background-color: rgb(221,221,221);
    border-radius: 12px 12px 0px 0px;
    height: 16px;
    touch-action: initial;
    pointer-events: initial;
    width: 64px;
    margin-left: 24px;
  }
  .window-container {
    grid-row: 2;
    display: flex;
    flex-direction: row;
    height: calc(100% - 32px);
  }
  #float-variables-container {
    flex-direction: column;
  }
  #notes-window-iframe-container {
    margin: auto;
    border: none;
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
  }
  #notes-buttons, #macros-buttons {
    display: block;
    height: 24px;
    margin-left: 0.5em;
  }
  #notes-window-iframe-container iframe {
    height: calc(100% - 16px);
    border: none;
  }
  #note-view-editor-container {
    height: calc(100% - 16px);
    width: 100%;
  }
  #macro-editor {
    height: 100%;
    width: 100%;
    padding-right: 12px;
  }
  #note-view-title, #macro-view-title, #macro-view-group {
    resize: none;
    width: 100%;
    font-family: monospace;
  }
  #macro-view-group::after{
    content: "Group: ";
  }
  #note-view-edit, #macro-view-edit {
    resize: none;
    font-family: monospace;
    width: 100%;
  }
  #note-view-edit {
    height: 50%;
  }
  #macro-view-edit {
    height: 50%;
  }
  #note-view-editor-log, #macro-test-log {
    height: 20%;
    color: #800;
    border: 1px solid grey;
    overflow-y: auto;
  }
  #macro-test-log {
    margin: 8px;
    padding: 8px;
    -webkit-user-select: initial;
    user-select: initial;
  }
  .window-group-list {
    display: flex;
    flex-direction: column;
    width: 18em;
    overflow-y: auto;
    height: 100%;
  }
  .window-group-list div {
    padding: 8px;
    border-bottom: 1px solid black;
    cursor: pointer;
    display: flex;
    flex-direction: row;
    -webkit-user-select: none;
    user-select: none;
  }
  .window-group-list div:hover {
    background-color: #f8f8f8;
  }
  .window-group-list div.active:hover {
    background-color: rgb(233, 233, 255);
  }
  .window-group-list div.active {
    background-color: rgb(211, 211, 255);
  }
  .window-closer {
    text-align: center;
    font-size: 24px;
    padding: 4px 12px;
    cursor: pointer;
    height: 32px;
    grid-row: 1;
  }
  .window-closer:hover {
    background-color: rgba(0, 0, 0, 0.1);
  }
  .window-title {
    text-align: center;
    font-size: 24px;
    padding: 4px 12px;
    cursor: pointer;
    height: 32px;
    grid-column: 2;
    grid-row: 1;
    pointer-events: none;
  }
  .variable-table-row {
    display: table-row;
  }
  .variable-table-row > div {
    display: table-cell;
    padding: 2px;
    text-align: center;
  }
  .variable-table-row > div > input {
    width: 8em;
  }
  .variable-table-row > div > input[type="numeric"] {
    width: 4em;
  }
  .variable-table-row > div> input[type="checkbox"] {
    width: 4em;
    margin-left: 35%;
  }
  /*endcss*/
::js
  let raw = ctx.make_node(NodeType.RAW);
  node.parent.replace_child(node, raw);
  const windows = [];
  function make_window(prefix, title, content){
    windows.push(prefix);
    const inner = `
      <div id="${prefix}-window" style="display:none" class="window">
      <div id="${prefix}-window-handle" class="window-handle">
        <span class="window-title">${title}</span>
        <span id="${prefix}-close" class="window-closer">X</span>
      </div>
      ${content}
      </div>
    `;
    raw.add_child(inner);
  }
  make_window('notes', 'Notes', `
    <div id="notes-container" class="window-container">
      <div id="notes-list" class="window-group-list">
        <button id="new-note">
          + New Note
        </button>
      </div>
      <div id="notes-window-iframe-container">
        <div id="notes-buttons">
          <button id="edit-notes-button">Edit</button>
          <button id="delete-note">Delete</button>
        </div>
        <iframe id="current-note-view"></iframe>
      </div>
      <div id="note-view-editor-container" style="display:none">
        <textarea spellcheck="false" id="note-view-title" rows=1></textarea>
        <textarea spellcheck="false" id="note-view-edit"></textarea>
        <div id="note-view-editor-log"></div>
      </div>
    </div>
  `);
  make_window('macros', 'Macros', `
    <div id="macros-container" class="window-container">
      <div id="macros-group-list" class="window-group-list">
        <button id="new-macro-group">+ New Category</button>
      </div>
      <div id="macros-list" class="window-group-list">
        <button id="new-macro">
          + New Macro
        </button>
      </div>
      <div id="macro-editor" style="visibility:hidden;">
        <div id="macros-buttons">
          <button id="delete-macro">Delete</button>
          <button id="test-macro">Test</button>
          <button id="use-macro">Use</button>
        </div>
        <div style="display:table; width: 100%;">
          <div style="display:table-row; width: 100%;"><span style="display:table-cell; vertical-align:top; padding-left: 8px;">Name: </span><textarea spellcheck="false" id="macro-view-title" rows=1 style="display:table-cell;"></textarea></div>
        </div>
        <textarea spellcheck="false" id="macro-view-edit"></textarea>
        <div id="macro-test-log"></div>
      </div>
    </div>
  `);
  make_window('variables', 'Variables', `
    <div id="variables-container" class="window-container">
      <div id="variables-group-list" class="window-group-list">
        <button id="variables-add-category">+ Add Category</button>
      </div>
      <div id="variables-editor">
        <button id="variable-add-variable">+ Add Variable</button>
        <div style="display:table;" id="variables-table">
          <div style="display:table-row;" class="variables-row variable-table-row" id="variables-table-header">
            <div style="display:table-cell;"><b>Type</b></div>
            <div style="display:table-cell;"><b>Name</b></div>
            <div style="display:table-cell;"><b>Value</b></div>
            <div style="display:table-cell;"><b>UI</b></div>
            <div style="display:table-cell;"><b>Delete</b></div>
          </div>
          <div style="display:table-row;" class="variables-row">
            <input style="display:table-cell;" value="Str"></input>
            <select style="display:table-cell;">
              <option value="number">Number</option>
              <option value="boolean">Boolean</option>
            </select>
            <input style="display: table-cell;" type="numeric" value="0"></input>
            <input style="display:table-cell;" type="checkbox"></input>
          </div>
        </div>
      </div>
    </div>
  `);
  make_window('float-variables', 'Quick Vars', `
    <div id="float-variables-container" class="window-container">
    </div>
  `);
  if(ctx.outpath.includes('temp')){
    let ts = '// NOTE: this file was generated\n'
    ts += '// Do NOT edit it. Your edits will be overwritten!\n'
    ts += '\n';
    ts += 'interface SubWindowIdMap {\n';
    for(let prefix of windows){
      ts += `  '${prefix}': SubWindow;\n`;
    }
    ts += '}\n\n';
    FileSystem.write_file('Generated/subwindowdefs.ts', ts);
  }
  //endjs
::js
  let raw = ctx.make_node(NodeType.RAW);
  node.parent.replace_child(node, raw);
  let current_prefix = '';
  let items = {};
  let prefixes = [];
  function begin(prefix){
    current_prefix = prefix;
    items[prefix] = [];
    prefixes.push(prefix);
  }
  function make(content){
    let prefix = current_prefix;
    content = content.replaceAll('id="', 'id="'+prefix+'-');
    content = content.replaceAll('for="', 'for="'+prefix+'-');
    content = content.replaceAll('name="', 'name="'+prefix+'-');
    const html =
    `<div id="${prefix}" style="display:none;" class="hover">
    <div id="${prefix}-window-handle" class="window-handle">
    <span id="${prefix}-window-close" class="window-closer">X</span>
    </div>
    ${content}
    <div class="hover-button-container">
      <button type="button" id="${prefix}-ok">Ok</button>
      <button type="button" id="${prefix}-cancel">Cancel</button>
    </div>
    </div>`;
    raw.add_child(html);
  }
  function label(name, text){
    return `<label for="${name}">${text}</label>`;
  }
  function numbox(name){
    items[current_prefix].push([name, 'HTMLInputElement']);
    return `<input type="number" name="${name}" id="${name}" class="numeric-input">`;
  }
  function checkbox(name){
    items[current_prefix].push([name, 'HTMLInputElement']);
    return `<input type="checkbox" name="${name}" id="${name}" checked>`;
  }
  function urlbox(name){
    items[current_prefix].push([name, 'HTMLInputElement']);
    return `<input type="url" name="${name}" id="${name}" value="">`;
  }
  function textbox(name){
    items[current_prefix].push([name, 'HTMLInputElement']);
    return `<input type="text" name="${name}" id="${name}" value="">`;
  }
  function title(text){
    items[current_prefix].push(['title', 'HTMLHeadingElement']);
    return `<h2 id="title">${text}</h2>`;
  }
  function textarea(name){
    items[current_prefix].push([name, 'HTMLTextAreaElement']);
    return `<textarea name="${name}" id="${name}"></textarea>`
  }
  function radio(name){
    items[current_prefix].push([name, 'HTMLInputElement']);
    return `<input type="radio" id="${name}" name="${name}" value="auto">`;
  }
  function colorbox(name){
    items[current_prefix].push([name, 'HTMLInputElement']);
    return `<input type="color" id="${name}" name="${name}">`;
  }
  // for when you just need a placeholder div.
  function div(name){
    items[current_prefix].push([name, 'HTMLDivElement']);
    return `<div id="${name}"></div>`
  }
  function selectbegin(name){
    items[current_prefix].push([name, 'HTMLSelectElement']);
    return `<select id="${name}">`;
  }
  function trbegin(name){
    items[current_prefix].push([name, 'HTMLTableRowElement']);
    return `<tr id="${name}">`;
  }
  function tablebegin(name){
    items[current_prefix].push([name, 'HTMLTableElement']);
    return `<table id="${name}">`;
  }
  function button(name, text){
    items[current_prefix].push([name, 'HTMLButtonElement']);
    return `<button id="${name}">${text}</button>`;
  }
  // We have this stupid begin thing as the function calls
  // inside the template strings will be evaluated eagerly,
  // so it is too late to set the current prefix before we
  // get to them.
  begin('image-input');
  make(`
    ${title("Enter Image")}
    <table class="input-container">
      <tr>
        <td>${label("width", "Width:")}${numbox("width")}
        <td>${label("height", "Height:")}${numbox("height")}
        <td>${label("checkbox", "Round to Grid:")}${checkbox("checkbox")}
      </tr>
      <tr>
        <td colspan="3">${label("url", "URL:")}${urlbox("url")}
      </tr>
    </table>
  `);

  begin('text-input');
  make(`
    ${title("Enter Image")}
    <table class="input-container">
      <tr>
        <td>${label("size", "Size:")}
        <td>${numbox("size")}
        <tr>
          <td>Alignment:
          <td>
              ${radio("left")}${label("left", "Left")}
              ${radio("center")}${label("center", "Center")}
              ${radio("right")}${label("right", "Right")}
          </td>
        </tr>
        <tr>
          <td>${label("text", "Text:")}
          <td>${textarea("text")}
        </tr>
        <tr>
          <td>Link To:
          <td>
            ${selectbegin('link-dungeon')}
              <option value="-1">No Link</option>
            </select>
        </tr>
    </table>
  `);
  begin('map-input');
  make(`
    ${title('New Map')}
    <table class='input-container'>
      <tr>
        <td>${label('name', 'Map Name:')}
        <td>${textbox('name')}
      </tr>
      <tr>
        <td>${label('hex-grid', 'Hex Grid')}
        <td>${checkbox('hex-grid')}
      </tr>
      <tr>
        <td>${label('no-grid', 'No Grid')}
        <td>${checkbox('no-grid')}
      </tr>
      <tr>
        <td>${label('numbered', 'Numbered')}
        <td>${checkbox('numbered')}
      </tr>
    </table>`);
  begin('map-delete');
  make(`
    ${title('Delete Map')}
    <table class="input-container">
      ${trbegin('can')}
        <td>${label('delete', 'DeleteMap')}
        <td>${checkbox('delete')}
      </tr>
      ${trbegin('cant')}
        <td >This map can't be deleted.
      </tr>
    </table>`);
  begin('ez-token');
  make(`
    ${title('New Token')}
    <table class="input-container">
      <tr>
        <td>${label('color', 'Color:')}
        <td>${colorbox('color')}
      </tr>
      <tr>
        <td>${label('width', 'Width (sq):')}
        <td>${numbox('width')}
        <td>${label('height', 'Height (sq):')}
        <td>${numbox('height')}
      </tr>
      <tr>
        <td>${label('text', 'Text:')}
        <td colspan="3">${textbox('text')}
      </tr>
    </table>
    ${div('conditions')}
    `);
  begin('img-token');
  make(`
    ${title('New Token')}
    ${div('gallery')}
    <table class="input-container">
      <tr>
        <td>${label('width', 'Width (sq):')}
        <td>${numbox('width')}
        <td>${label('height', 'Height (sq):')}
        <td>${numbox('height')}
      </tr>
      <tr>
        <td>${label('url', 'Token Image Url:')}
        <td>${urlbox('url')}
      </tr>
    </table>
    ${div('conditions')}
    `);
  begin('macro-deletion');
  make(`
    ${title('Delete Macro')}
    <table class="input-container">
      <tr>
        <td>${label('checkbox', 'Delete Macro:')}
        <td>${checkbox('checkbox')}
      </tr>
    </table>`);
  begin('note-deletion');
  make(`
    ${title('Delete Note')}
    <table class="input-container">
      <tr>
        <td>${label('checkbox', 'Delete Note:')}
        <td>${checkbox('checkbox')}
      </tr>
    </table>`);
  begin('options');
  make(`
    ${title('Options')}
    <table class="input-container">
      <tr>
        <td>${label('chatname', 'Chat Name:')}
        <td>${textbox('chatname')}
      </tr>
    </table>
    <div class="hover-button-container">
      ${label('hidepan', 'Hide Pan Tool')}
      ${checkbox('hidepan')}
      <br>
        <span style="font-weight:bold">Dark Mode:</span>
        ${radio('system')}
        ${label('system', 'System')}
        ${radio('dark')}
        ${label('dark', 'Dark')}
        ${radio('light')}
        ${label('light', 'Light')}
        <br>
        <span>(might need reload)</span>
        <br>
        ${button('export', 'Export')}
        ${button('import', 'Import')}
    </div>
    ${tablebegin('dev')}
      <tr>
        <td>${checkbox('fps')} ${label('fps', 'Show FPS')}
      </tr>
    </table>
    `);
  begin('simple-text');
  make(`
    ${title("Text")}
    <table class="input-container">
      <tr>
        <td>${label('text', 'Text:')}
        <td>${textbox('text')}
      </tr>
    </table>
    `);
  if(ctx.outpath.includes('temp')){
    let ts = '// NOTE: this file was generated\n'
    ts += '// Do NOT edit it. Your edits will be overwritten!\n'
    ts += '\n';
    ts += 'interface DialogIdMap {\n';
    for(let prefix of prefixes){
      ts += `  '${prefix}': {\n`;
      for(let pair of items[prefix]){
        ts += `    "${pair[0]}": ${pair[1]};\n`;
      }
      ts += `  };\n`;
    }
    ts += '}\n\n';
    ts += `
  const DIALOGS: Map<string, any> = new Map();

  function get_or_make_dialog<Key extends keyof DialogIdMap>(name:Key):Dialog<Key>{
      if(DIALOGS.has(name)) return DIALOGS.get(name)!;
      function register(fields: Array<string>): any{
          let dialog = make_dialog(name, fields);
          DIALOGS.set(name, dialog);
          return dialog;
      }
      switch(name){\n`;
    for(let prefix of prefixes){
      ts += `        case '${prefix}':\n`;
      ts += `            return register([`;
      for(let pair of items[prefix])
        ts += `'${pair[0]}', `;
      ts += `]);\n`
    }
    ts+=
    `   }
        throw new Error();
    }
    `;
    FileSystem.write_file('Generated/dialogdefs.ts', ts);
  }


